ccpp:CW_SUPPLY a ccpp:SupplyConnection ;
    rdfs:label "Cooling water supply (building)" ;
    ccpp:citedIn ccpp:CW_SUPPLY__utlcit01 ;
    ccpp:feedsInto ccpp:V194,
        ccpp:V208,
        ccpp:V405 ;
    ccpp:floor 1 ;
    ccpp:note "Untagged connection feeding the three cooling water streams (C106, C200, C400)." ;
    ccpp:pipedTo ccpp:V194,
        ccpp:V208,
        ccpp:V405 ;
    ccpp:tag "CW_SUPPLY" .

ccpp:FI106 a ccpp:FlowInstrument ;
    rdfs:label "FI106" ;
    ccpp:citedIn ccpp:FI106__utlcit01,
        ccpp:FI106__utlcit02 ;
    ccpp:floor 1 ;
    ccpp:gridReference "R16" ;
    ccpp:measuredVariable "C106 cooling water flow indication (local, on FT106)" ;
    ccpp:monitors ccpp:C106 ;
    ccpp:tag "FI106" .

ccpp:FI200 a ccpp:FlowInstrument ;
    rdfs:label "FI200" ;
    ccpp:citedIn ccpp:FI200__utlcit01,
        ccpp:FI200__utlcit02 ;
    ccpp:floor 2 ;
    ccpp:gridReference "H11" ;
    ccpp:measuredVariable "C200 cooling water flow indication (local)" ;
    ccpp:monitors ccpp:C200 ;
    ccpp:tag "FI200" .

ccpp:FI201 a ccpp:FlowInstrument ;
    rdfs:label "FI201" ;
    ccpp:citedIn ccpp:FI201__utlcit01,
        ccpp:FI201__utlcit02 ;
    ccpp:floor 2 ;
    ccpp:gridReference "H12" ;
    ccpp:measuredVariable "C200 cooling water flow indication (local, on FT201)" ;
    ccpp:monitors ccpp:C200 ;
    ccpp:tag "FI201" .

ccpp:HAZOP_13_01 ccpp:concerns ccpp:V106 .

ccpp:HAZOP_13_04 ccpp:concerns ccpp:FCV110 .

ccpp:HAZOP_13_06 ccpp:concerns ccpp:K100,
        ccpp:V106 .

ccpp:HAZOP_element_13 ccpp:covers ccpp:K100,
        ccpp:NRV110,
        ccpp:PT101,
        ccpp:RV107,
        ccpp:TT117,
        ccpp:TT118,
        ccpp:V100,
        ccpp:V103,
        ccpp:V104,
        ccpp:XV140 .

ccpp:K100_bypass a ccpp:BypassRoute ;
    rdfs:label "Condensate bypass around K100 via V106" ;
    ccpp:bypasses ccpp:K100 ;
    ccpp:citedIn ccpp:K100_bypass__utlcit01 ;
    ccpp:fromItem ccpp:H100_N_condensate_out ;
    ccpp:normalState "closed" ;
    ccpp:routeVia ccpp:V106 ;
    ccpp:toItem ccpp:V103 .

