ccpp:SteamRoute a ccpp:Loop ;
    rdfs:label "Steam and condensate route to H100" ;
    ccpp:citedIn ccpp:SteamRoute__utlcit01,
        ccpp:SteamRoute__utlcit02,
        ccpp:SteamRoute__utlcit03 ;
    ccpp:hasStep ccpp:SteamRoute_step_00_STEAM_SUPPLY,
        ccpp:SteamRoute_step_01_XV140,
        ccpp:SteamRoute_step_02_V100,
        ccpp:SteamRoute_step_03_PT101,
        ccpp:SteamRoute_step_04_PI100,
        ccpp:SteamRoute_step_05_V101,
        ccpp:SteamRoute_step_06_FT100,
        ccpp:SteamRoute_step_07_FI100,
        ccpp:SteamRoute_step_08_V102,
        ccpp:SteamRoute_step_09_FT101,
        ccpp:SteamRoute_step_10_FCV110,
        ccpp:SteamRoute_step_11_TT117,
        ccpp:SteamRoute_step_12_H100_N_steam_in,
        ccpp:SteamRoute_step_13_H100_N_condensate_out,
        ccpp:SteamRoute_step_14_TT118,
        ccpp:SteamRoute_step_15_PI101,
        ccpp:SteamRoute_step_16_RV107,
        ccpp:SteamRoute_step_17_K100,
        ccpp:SteamRoute_step_18_V106,
        ccpp:SteamRoute_step_19_V103,
        ccpp:SteamRoute_step_20_V104,
        ccpp:SteamRoute_step_21_V105,
        ccpp:SteamRoute_step_22_NRV110,
        ccpp:SteamRoute_step_23_CONDENSATE_RETURN ;
    ccpp:inMode ccpp:FigureOfEight ;
    ccpp:note "Building steam heats the MEA in the H100 reboiler shell and leaves as condensate through the K100 trap. FCV110 sets the steam flow (TIC100 > FIC100 cascade, stripping loop)." .

ccpp:UT01 a ccpp:OpenItem ;
    rdfs:label "UT01: Order along the steam line (XV140 > V100 > PT101 > V101 > FT100 > V102 > FT101 > FCV110 > H100 > K100 > V103 > V105 > NRV110) is inferred" ;
    ccpp:about ccpp:K100,
        ccpp:NRV110,
        ccpp:V100,
        ccpp:XV140 ;
    ccpp:citedIn ccpp:UT01__utlcit01 ;
    ccpp:description "Order along the steam line (XV140 > V100 > PT101 > V101 > FT100 > V102 > FT101 > FCV110 > H100 > K100 > V103 > V105 > NRV110) is inferred" ;
    ccpp:foundBy "utl section build, Oct 2026" ;
    ccpp:itemStatus "open" ;
    ccpp:resolvedBy "Trace on the P&ID" .

ccpp:UT02 a ccpp:OpenItem ;
    rdfs:label "UT02: K100 (HAZOP 13: trap whose fault redirects flow via V106) is not in the REPORT lists; its tag and position need confirming" ;
    ccpp:about ccpp:K100 ;
    ccpp:citedIn ccpp:UT02__utlcit01 ;
    ccpp:description "K100 (HAZOP 13: trap whose fault redirects flow via V106) is not in the REPORT lists; its tag and position need confirming" ;
    ccpp:foundBy "utl section build, Oct 2026" ;
    ccpp:itemStatus "open" ;
    ccpp:resolvedBy "Full-size P&ID" .

ccpp:UT03 a ccpp:OpenItem ;
    rdfs:label "UT03: V101, V102, V105 and V106 are recorded closed (stripping loop test line-up) but V100 to V105 are open in normal running (Figs B.2, F.11)" ;
    ccpp:about ccpp:V100,
        ccpp:V103 ;
    ccpp:citedIn ccpp:UT03__utlcit01 ;
    ccpp:description "V101, V102, V105 and V106 are recorded closed (stripping loop test line-up) but V100 to V105 are open in normal running (Figs B.2, F.11)" ;
    ccpp:foundBy "utl section build, Oct 2026" ;
    ccpp:itemStatus "open" ;
    ccpp:resolvedBy "Mode-dependent valve settings, as for V217" .

