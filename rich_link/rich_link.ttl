    ccpp:description "V150 is on the rich MEA stream list (closed) but its function and connection are not identified" ;
    ccpp:foundBy "rich section build, Oct 2026" ;
    ccpp:itemStatus "open" ;
    ccpp:resolvedBy "Full-size P&ID" .

ccpp:ROI02 a ccpp:OpenItem ;
    rdfs:label "ROI02: V319 is on the rich MEA stream list at grid G8, next to the E100 side-return nozzle; it may be on the side-return line (routes C and D)" ;
