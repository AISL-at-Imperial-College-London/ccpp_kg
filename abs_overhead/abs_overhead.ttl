ccpp:AbsorberOverheadRoute a ccpp:Loop ;
    rdfs:label "Absorber overhead and vent route" ;
    ccpp:citedIn ccpp:AbsorberOverheadRoute__aovcit01,
        ccpp:AbsorberOverheadRoute__aovcit02,
        ccpp:AbsorberOverheadRoute__aovcit03 ;
    ccpp:hasStep ccpp:AbsorberOverheadRoute_step_00_E101,
        ccpp:AbsorberOverheadRoute_step_01_E101_N_gas_outlet,
        ccpp:AbsorberOverheadRoute_step_02_TT412,
        ccpp:AbsorberOverheadRoute_step_03_TT413,
        ccpp:AbsorberOverheadRoute_step_04_K402,
        ccpp:AbsorberOverheadRoute_step_05_PT403,
        ccpp:AbsorberOverheadRoute_step_06_V409,
        ccpp:AbsorberOverheadRoute_step_07_PCV300,
        ccpp:AbsorberOverheadRoute_step_08_FT300,
        ccpp:AbsorberOverheadRoute_step_09_FT302,
        ccpp:AbsorberOverheadRoute_step_10_VENT_E101 ;
    ccpp:inMode ccpp:FigureOfEight ;
    ccpp:note "Lean gas leaves the top of E101, passes the K402 cyclone separator (liquid returns to E101) and is vented through PCV300, which holds the E101 pressure (PIC403). Part of the gas goes to the N2 return (piece 7); where it splits from the vent line is to be traced (AV01)." .

