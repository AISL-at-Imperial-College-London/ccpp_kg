ns1:TRIP_AZALL101 a ns1:SafetyTrip ;
    rdfs:label "O2 level LL (AZALL-101, AZALL-102)" ;
    ns1:actionText "FULL PLANT SHUTDOWN. Stops J100, J101a, J101b, J102, J103, J104, J105, J300, H200a, H200b. Closes XV128, XV129, SDV171, SDV123, SDV125, SDV152, XV140, FCV110. Also: all control loops to manual, output 0%; beacon; klaxon." ;
    ns1:citedIn ns1:TRIP_AZALL101__sflcit01 ;
    ns1:closes ns1:FCV110,
        ns1:SDV123,
        ns1:SDV125,
        ns1:SDV152,
        ns1:SDV171,
        ns1:XV128,
        ns1:XV129,
        ns1:XV140 ;
    ns1:handledBy "safety system" ;
    ns1:interlockGroup "1" ;
    ns1:setpointText "19.5%" ;
    ns1:stops ns1:H200a,
        ns1:H200b,
        ns1:J100,
        ns1:J101a,
        ns1:J101b,
        ns1:J102,
        ns1:J103,
        ns1:J104,
        ns1:J105,
        ns1:J300 ;
    ns1:switchTag "AZALL101" ;
    ns1:tag "TRIP_AZALL101" ;
    ns1:triggerCondition "O2 level LL: Extreme low level in plant, AT-101, AT-102 (AZALL-101, AZALL-102); set point 19.5%" ;
    ns1:tripTag "AZALL-101, AZALL-102" .

ns1:TRIP_AZALL101__sflcit01 a ns1:Citation ;
    rdfs:label "Citation 1 for TRIP_AZALL101 (sfl)" ;
    ns1:citationText "C&E matrix Rev 5 cause row 'O2 level LL', tag AZALL-101, AZALL-102" ;
    ns1:document ns1:SRC_CE ;
    ns1:location "cause row 'O2 level LL', tag AZALL-101, AZALL-102" .

ns1:TRIP_FALL301 a ns1:SafetyTrip ;
    rdfs:label "CO2 flow LL (FALL-301, FALL-302)" ;
    ns1:actionText "Stops J103. Also: alarm." ;
    ns1:citedIn ns1:TRIP_FALL301__sflcit01 ;
    ns1:delayText "2mins." ;
    ns1:detectedAt ns1:FT301,
        ns1:FT302 ;
    ns1:handledBy "safety system" ;
    ns1:interlockGroup "2" ;
    ns1:setpointText "User Set Point" ;
    ns1:stops ns1:J103 ;
    ns1:switchTag "FALL301" ;
    ns1:tag "TRIP_FALL301" ;
    ns1:triggerCondition "CO2 flow LL: Extreme low CO2 return flow, F-301/302 (FALL-301, FALL-302); set point User Set Point; delay 2mins.; start-up override: try it three times" ;
    ns1:tripTag "FALL-301, FALL-302" .

ns1:TRIP_FALL301__sflcit01 a ns1:Citation ;
