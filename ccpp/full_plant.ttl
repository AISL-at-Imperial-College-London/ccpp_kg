    ns1:controlledVariable "Pressure in E100" ;
    ns1:hasController ns1:PIC401,
        ns1:PIC402 ;
    ns1:hasFinalElement ns1:PCV119 ;
    ns1:hasSensor ns1:PT401,
        ns1:PT402 ;
    ns1:manipulatedVariable "PCV119 opening" ;
    ns1:source "SUMMARY p.190; REPORT D.4" .

ns1:CL_E101_level a ns1:ControlLoop ;
    rdfs:label "E101 sump level (pump speed)" ;
    ns1:citedIn ns1:CL_E101_level__abscit01,
        ns1:CL_E101_level__abscit02 ;
    ns1:controlledVariable "Level in the bottom of E101" ;
    ns1:hasController ns1:LIC108,
        ns1:SIC101a,
        ns1:SIC101b ;
    ns1:hasFinalElement ns1:J101a,
        ns1:J101b ;
    ns1:hasSensor ns1:LT108 ;
    ns1:manipulatedVariable "Speed of J101a/b" .

ns1:CL_E101_pressure a ns1:ControlLoop ;
    rdfs:label "Absorber (E101) pressure (on vent rate)" ;
    ns1:citedIn ns1:CL_E101_pressure__aovcit01,
        ns1:CL_E101_pressure__aovcit02 ;
    ns1:controlledVariable "Pressure in E101" ;
    ns1:hasController ns1:PIC403 ;
    ns1:hasFinalElement ns1:PCV300 ;
    ns1:hasSensor ns1:PT403 ;
    ns1:manipulatedVariable "Opening of PCV300 (lean gas vent rate)" .

ns1:CL_H100_temperature_master a ns1:ControlLoop ;
    rdfs:label "Temperature of MEA leaving H100 (cascade master)" ;
    ns1:cascadeMasterOf ns1:CL_H100_steam_slave ;
    ns1:citedIn ns1:CL_H100_temperature_master__cit01,
        ns1:CL_H100_temperature_master__cit02 ;
    ns1:controlledVariable "Temperature of MEA leaving H100 into E100" ;
    ns1:hasController ns1:TIC100 ;
    ns1:hasFinalElement ns1:FCV110 ;
    ns1:hasSensor ns1:TT100 ;
    ns1:manipulatedVariable "Steam flow set point for FIC100" ;
    ns1:source "SUMMARY p.190; REPORT D.4.4.c" .

ns1:CL_H200a_temperature a ns1:ControlLoop ;
    rdfs:label "Temperature of MEA entering E100, heater leg A" ;
    ns1:citedIn ns1:CL_H200a_temperature__cit01,
        ns1:CL_H200a_temperature__cit02 ;
    ns1:controlledVariable "Temperature of MEA entering E100" ;
    ns1:hasController ns1:TIC213a,
        ns1:TY213a ;
    ns1:hasFinalElement ns1:H200a ;
    ns1:hasSensor ns1:TT213 ;
    ns1:manipulatedVariable "Thermal duty of H200a" ;
    ns1:source "SUMMARY p.190; REPORT D.4.4.a" .

ns1:CL_H200b_temperature a ns1:ControlLoop ;
    rdfs:label "Temperature of MEA entering E100, heater leg B" ;
    ns1:citedIn ns1:CL_H200b_temperature__cit01,
        ns1:CL_H200b_temperature__cit02 ;
    ns1:controlledVariable "Temperature of MEA entering E100" ;
    ns1:hasController ns1:TIC213b,
        ns1:TY213b ;
    ns1:hasFinalElement ns1:H200b ;
    ns1:hasSensor ns1:TT213 ;
