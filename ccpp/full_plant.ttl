ns1:TRIP_TSHH115 a ns1:SafetyTrip ;
    rdfs:label "Pump temperature HH (TZAHH-115)" ;
    ns1:actionText "FULL PLANT SHUTDOWN. Stops J100, J101a, J101b, J102, J103, J104, J105, J300, H200a, H200b. Closes XV128, XV129, SDV171, SDV123, SDV125, SDV152, XV140, FCV110. Also: all control loops to manual, output 0%." ;
    ns1:citedIn ns1:TRIP_TSHH115__sflcit01 ;
    ns1:closes ns1:FCV110,
        ns1:SDV123,
        ns1:SDV125,
        ns1:SDV152,
        ns1:SDV171,
        ns1:XV128,
        ns1:XV129,
        ns1:XV140 ;
    ns1:detectedAt ns1:J103 ;
    ns1:handledBy "safety system" ;
    ns1:interlockGroup "3" ;
    ns1:setpointText "85 degC" ;
    ns1:stops ns1:H200a,
        ns1:H200b,
        ns1:J100,
        ns1:J101a,
        ns1:J101b,
        ns1:J102,
        ns1:J103,
        ns1:J104,
        ns1:J105,
        ns1:J300 ;
    ns1:switchTag "TSHH115" ;
    ns1:tag "TRIP_TSHH115" ;
    ns1:triggerCondition "Pump temperature HH: Pump J103 temperature high, TSHH-115 (TZAHH-115); set point 85 degC" ;
    ns1:tripTag "TZAHH-115" .

