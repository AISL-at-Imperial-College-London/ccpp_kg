        ns1:OverheadRefluxLoop_step_02_PT401,
        ns1:OverheadRefluxLoop_step_03_C400,
        ns1:OverheadRefluxLoop_step_04_LSHH400,
        ns1:OverheadRefluxLoop_step_05_K401,
        ns1:OverheadRefluxLoop_step_06_LT401,
        ns1:OverheadRefluxLoop_step_07_J300,
        ns1:OverheadRefluxLoop_step_08_TT310,
        ns1:OverheadRefluxLoop_step_09_RV300,
        ns1:OverheadRefluxLoop_step_10_B300,
        ns1:OverheadRefluxLoop_step_11_PCV302,
        ns1:OverheadRefluxLoop_step_12_V317,
        ns1:OverheadRefluxLoop_step_13_TT309,
        ns1:OverheadRefluxLoop_step_14_FT305,
        ns1:OverheadRefluxLoop_step_15_V403,
        ns1:OverheadRefluxLoop_step_16_V402,
        ns1:OverheadRefluxLoop_step_17_E100_N_top_inlet,
        ns1:OverheadRefluxLoop_step_18_E100 ;
    ns1:inMode ns1:FigureOfEight ;
    ns1:note "Runs whenever E100 is boiling. Vapour is condensed in C400; K401 separates the condensate (returned as reflux by J300) from the CO2-rich gas (to the CO2 return, piece 7)." .

