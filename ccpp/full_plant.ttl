ns1:AbsorberOverheadRoute a ns1:Loop ;
    rdfs:label "Absorber overhead and vent route" ;
    ns1:citedIn ns1:AbsorberOverheadRoute__aovcit01,
        ns1:AbsorberOverheadRoute__aovcit02,
        ns1:AbsorberOverheadRoute__aovcit03 ;
    ns1:hasStep ns1:AbsorberOverheadRoute_step_00_E101,
        ns1:AbsorberOverheadRoute_step_01_E101_N_gas_outlet,
        ns1:AbsorberOverheadRoute_step_02_TT412,
        ns1:AbsorberOverheadRoute_step_03_TT413,
        ns1:AbsorberOverheadRoute_step_04_K402,
        ns1:AbsorberOverheadRoute_step_05_PT403,
        ns1:AbsorberOverheadRoute_step_06_V409,
        ns1:AbsorberOverheadRoute_step_07_PCV300,
        ns1:AbsorberOverheadRoute_step_08_FT300,
        ns1:AbsorberOverheadRoute_step_09_FT302,
        ns1:AbsorberOverheadRoute_step_10_VENT_E101 ;
    ns1:inMode ns1:FigureOfEight ;
    ns1:note "Lean gas leaves the top of E101, passes the K402 cyclone separator (liquid returns to E101) and is vented through PCV300, which holds the E101 pressure (PIC403). Part of the gas goes to the N2 return (piece 7); where it splits from the vent line is to be traced (AV01)." .

