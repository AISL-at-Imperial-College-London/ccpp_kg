ns1:PROC_heater_overtemperature__cit01 a ns1:Citation ;
    rdfs:label "Citation 1 for PROC_heater_overtemperature" ;
    ns1:citationText "Pilot Plant Report E.3.4" ;
    ns1:document ns1:SRC_REPORT ;
    ns1:location "E.3.4" .

ns1:PROC_heater_overtemperature_step_01 a ns1:ProcedureStep ;
    rdfs:label "MEA entering E100 too hot (heater over-temperature) step 1" ;
    ns1:instruction "Check the heater set point in the control room is 25 C; if not, set it to 25 C" ;
    ns1:operatesOn ns1:TT213 ;
    ns1:stepOrder 1 .

ns1:PROC_heater_overtemperature_step_02 a ns1:ProcedureStep ;
    rdfs:label "MEA entering E100 too hot (heater over-temperature) step 2" ;
    ns1:instruction "If the set point is 25 C and the MEA temperature is still rising, manually shut off H200a" ;
    ns1:operatesOn ns1:H200a ;
    ns1:stepOrder 2 .

ns1:PROC_heater_overtemperature_step_03 a ns1:ProcedureStep ;
    rdfs:label "MEA entering E100 too hot (heater over-temperature) step 3" ;
    ns1:instruction "Manually shut off H200b" ;
    ns1:operatesOn ns1:H200b ;
    ns1:stepOrder 3 .

ns1:PROC_heater_overtemperature_step_04 a ns1:ProcedureStep ;
    rdfs:label "MEA entering E100 too hot (heater over-temperature) step 4" ;
    ns1:instruction "If TT213 still reads above 25 C, send an operator to check TI213" ;
    ns1:operatesOn ns1:TI213 ;
    ns1:stepOrder 4 .

ns1:PROC_heater_overtemperature_step_05 a ns1:ProcedureStep ;
    rdfs:label "MEA entering E100 too hot (heater over-temperature) step 5" ;
    ns1:instruction "If TI213 does not match TT213, follow emergency procedure E.3.12" ;
    ns1:operatesOn ns1:TT213 ;
    ns1:stepOrder 5 .

ns1:PROC_heater_overtemperature_step_06 a ns1:ProcedureStep ;
    rdfs:label "MEA entering E100 too hot (heater over-temperature) step 6" ;
    ns1:instruction "If both TT213 and TI213 read above 25 C, send a mechanical engineer to check H200a and H200b" ;
    ns1:operatesOn ns1:H200a ;
    ns1:stepOrder 6 .

ns1:PROC_pump_start_order__abscit01 a ns1:Citation ;
    rdfs:label "Citation 1 for PROC_pump_start_order (absorption loop)" ;
    ns1:citationText "Pilot Plant Report section F.5.4.5 and F.5.4.7" ;
    ns1:document ns1:SRC_REPORT ;
    ns1:location "section F.5.4.5 and F.5.4.7" .

ns1:PROC_pump_start_order_step_01 a ns1:ProcedureStep ;
    rdfs:label "Order of starting J100 and J101a/b step 1" ;
    ns1:instruction "Compare LT101 (E100) and LT108 (E101)" ;
    ns1:operatesOn ns1:LT108 ;
    ns1:stepOrder 1 .

ns1:PROC_pump_start_order_step_02 a ns1:ProcedureStep ;
    rdfs:label "Order of starting J100 and J101a/b step 2" ;
    ns1:instruction "If LT101 < LT108, start J100 before J101a/b to avoid overfilling" ;
    ns1:operatesOn ns1:J101a ;
    ns1:stepOrder 2 .

ns1:PROC_pump_start_order_step_03 a ns1:ProcedureStep ;
    rdfs:label "Order of starting J100 and J101a/b step 3" ;
    ns1:instruction "If LT101 >= LT108, start J101a/b before J100" ;
    ns1:operatesOn ns1:J101a ;
    ns1:stepOrder 3 .

ns1:PROC_pump_start_order_step_04 a ns1:ProcedureStep ;
    rdfs:label "Order of starting J100 and J101a/b step 4" ;
    ns1:instruction "Leave a 1-minute gap before starting the second pump" ;
    ns1:operatesOn ns1:J101a ;
    ns1:stepOrder 4 .

ns1:PROC_reboiler_heating__cit01 a ns1:Citation ;
    rdfs:label "Citation 1 for PROC_reboiler_heating" ;
    ns1:citationText "Pilot Plant Report E.3.5" ;
    ns1:document ns1:SRC_REPORT ;
    ns1:location "E.3.5" .

ns1:PROC_reboiler_heating_step_01 a ns1:ProcedureStep ;
    rdfs:label "Reboiler heating the MEA during the stripping loop test step 1" ;
    ns1:instruction "Check whether FT100 and FT101 show steam flowing to H100" ;
    ns1:operatesOn ns1:FT100 ;
    ns1:stepOrder 1 .

ns1:PROC_reboiler_heating_step_02 a ns1:ProcedureStep ;
    rdfs:label "Reboiler heating the MEA during the stripping loop test step 2" ;
    ns1:instruction "If steam is flowing, check in the control room that FCV110 is closed" ;
    ns1:operatesOn ns1:FCV110 ;
    ns1:requiredPosition "closed" ;
    ns1:stepOrder 2 .

ns1:PROC_reboiler_heating_step_03 a ns1:ProcedureStep ;
    rdfs:label "Reboiler heating the MEA during the stripping loop test step 3" ;
    ns1:instruction "Send an operator to check V100, V101 and V102 are closed" ;
    ns1:operatesOn ns1:V101 ;
    ns1:requiredPosition "closed" ;
    ns1:stepOrder 3 .

ns1:PROC_reboiler_heating_step_04 a ns1:ProcedureStep ;
    rdfs:label "Reboiler heating the MEA during the stripping loop test step 4" ;
    ns1:instruction "If all valves are closed and temperatures still rise, send an engineer to check for leaks and valve failure" ;
    ns1:operatesOn ns1:H100 ;
    ns1:stepOrder 4 .

ns1:PROC_reboiler_heating_step_05 a ns1:ProcedureStep ;
    rdfs:label "Reboiler heating the MEA during the stripping loop test step 5" ;
    ns1:instruction "If no steam is flowing, check the local indicators on floors 1 and 2 against TT203, TT200 and TT201" ;
    ns1:operatesOn ns1:TT200 ;
    ns1:stepOrder 5 .

ns1:PROC_reboiler_heating_step_06 a ns1:ProcedureStep ;
    rdfs:label "Reboiler heating the MEA during the stripping loop test step 6" ;
    ns1:instruction "If they do not match, follow emergency procedure E.3.12" ;
    ns1:operatesOn ns1:E100 ;
    ns1:stepOrder 6 .

