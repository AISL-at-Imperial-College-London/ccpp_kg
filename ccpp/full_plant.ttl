    ns1:handledBy "safety system" ;
    ns1:interlockGroup "8" ;
    ns1:stops ns1:J105 ;
    ns1:switchTag "LSHH111" ;
    ns1:tag "TRIP_LSHH111" ;
    ns1:triggerCondition "Storage tank level HH: Storage tank R100 liquid level high, LSHH-111 (LZAHH-111)" ;
    ns1:tripTag "LZAHH-111" .

ns1:TRIP_LSHH112 a ns1:SafetyTrip ;
