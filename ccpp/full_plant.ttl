ns1:COM_LT101_HIGH a ns1:AlarmResponse ;
    rdfs:label "Commissioning: LT101 rising above 90% (J100 test)" ;
    ns1:actionText "1. Increase J100 pump power by 10% every 2 minutes until LT101 is below 90%. 2. If the level still does not drop, send an operator into the plant to check V110 is open. 3. Once steady below 90%, continue the test at 5% above the last steady-state pump power." ;
    ns1:actsOn ns1:J100,
        ns1:V110 ;
    ns1:citedIn ns1:COM_LT101_HIGH__prccit01 ;
    ns1:note "Applies to the J100 commissioning test, not full operation (full operation uses the F.8.4 alarms at 85% and 95%)." ;
    ns1:respondsTo ns1:limit_COM_LT101_10 ;
    ns1:tag "COM_LT101_HIGH" ;
    ns1:triggerCondition "Commissioning SOP: LT101 above 90% during the J100 pump test" ;
    ns1:triggeredBy ns1:LT101 .

ns1:COM_LT101_LOW a ns1:AlarmResponse ;
    rdfs:label "Commissioning: LT101 dropping below 10% (J100 test)" ;
    ns1:actionText "1. Decrease J100 to the second-to-last steady-state value. 2. If the level keeps dropping over the next 2 minutes, reduce J100 speed by a further 10% every minute until it stops. 3. Once the level is steady above 10%, return to the last steady-state speed. 4. Increase pump speed by a smaller step than last time (10% to 5% to 2% to 1%); after a 1% step, the maximum pump power has been reached." ;
    ns1:actsOn ns1:J100 ;
    ns1:citedIn ns1:COM_LT101_LOW__prccit01 ;
    ns1:note "Applies to the J100 commissioning test, not full operation (full operation uses the F.8.4 alarms at 5% and 1%)." ;
    ns1:respondsTo ns1:limit_COM_LT101_10 ;
    ns1:tag "COM_LT101_LOW" ;
    ns1:triggerCondition "Commissioning SOP: LT101 below 10% during the J100 pump test" ;
    ns1:triggeredBy ns1:LT101 .

