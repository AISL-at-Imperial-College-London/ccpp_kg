ns1:ARP_LT104_H a ns1:AlarmResponse ;
    rdfs:label "LT104 high alarm response (K101 level)" ;
    ns1:actionText "1. Decrease the pump power of J102 by 10%. 2. Decrease the pump power of J103 by 5%. 3. Check the valve positions against table F.5. 4. If the level still rises and the HH alarm sounds, initiate emergency shutdown." ;
    ns1:actsOn ns1:J102,
        ns1:J103 ;
    ns1:citedIn ns1:ARP_LT104_H__prccit01 ;
    ns1:respondsTo ns1:limit_F84_LT104_H ;
    ns1:tag "ARP_LT104_H" ;
    ns1:triggerCondition "H alarm on LT104: K101 level above 85%; HH alarm (value not stated)" ;
    ns1:triggeredBy ns1:LT104 .

ns1:ARP_LT104_L a ns1:AlarmResponse ;
    rdfs:label "LT104 low alarm response (K101 level)" ;
    ns1:actionText "1. Increase the pump power of J102 by 10%. 2. Increase the pump power of J103 by 5%. 3. Check the valve positions against table F.5. 4. If the level still falls and the LL alarm sounds, initiate emergency shutdown." ;
    ns1:actsOn ns1:J102,
        ns1:J103 ;
    ns1:citedIn ns1:ARP_LT104_L__prccit01 ;
    ns1:respondsTo ns1:limit_F84_LT104_L ;
    ns1:tag "ARP_LT104_L" ;
    ns1:triggerCondition "L alarm on LT104: K101 level below 5%; LL alarm (value not stated)" ;
    ns1:triggeredBy ns1:LT104 .

