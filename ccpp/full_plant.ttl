ns1:OverheadRefluxLoop a ns1:Loop ;
    rdfs:label "Stripper overhead and reflux loop" ;
    ns1:citedIn ns1:OverheadRefluxLoop__ovhcit01,
        ns1:OverheadRefluxLoop__ovhcit02,
        ns1:OverheadRefluxLoop__ovhcit03 ;
    ns1:hasStep ns1:OverheadRefluxLoop_step_00_E100,
