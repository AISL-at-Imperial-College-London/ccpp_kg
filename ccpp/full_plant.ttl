    ns1:guideword "HIGHER" ;
    ns1:inElement ns1:HAZOP_element_8 ;
    ns1:itemNumber 7 ;
    ns1:parameter "PRESSURE" ;
    ns1:safeguard "Wholse system design pressure uniform" .

ns1:HAZOP_8_08 a ns1:HazopDeviation ;
