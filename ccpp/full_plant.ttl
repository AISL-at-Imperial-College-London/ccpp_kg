    ns1:citedIn ns1:CL_CO2_feed__gascit01 ;
    ns1:controlledVariable "CO2 feed rate" ;
    ns1:hasController ns1:FIC105 ;
    ns1:hasFinalElement ns1:FCV105 ;
    ns1:hasSensor ns1:FT105 ;
    ns1:manipulatedVariable "FCV105 opening" .

ns1:CL_E100_pressure a ns1:ControlLoop ;
