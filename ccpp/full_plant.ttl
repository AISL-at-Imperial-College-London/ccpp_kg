ns1:SL01 a ns1:OpenItem ;
    rdfs:label "SL01: XV128 (CO2 supply) and XV129 (N2 supply) shutdown valves are in the cause and effect matrix but not in the REPORT lists: find them on the P&ID near the supplies (K21 to K22 and N21 to N22)" ;
    ns1:about ns1:XV128,
        ns1:XV129 ;
    ns1:citedIn ns1:SL01__sflcit01 ;
    ns1:description "XV128 (CO2 supply) and XV129 (N2 supply) shutdown valves are in the cause and effect matrix but not in the REPORT lists: find them on the P&ID near the supplies (K21 to K22 and N21 to N22)" ;
    ns1:foundBy "sfl section build, Oct 2026" ;
    ns1:itemStatus "open" ;
    ns1:resolvedBy "Trace on the P&ID" .

ns1:SL02 a ns1:OpenItem ;
    rdfs:label "SL02: The matrix calls K102 the 'relief collection vessel' (LSHH-110, full plant shutdown); the KG holds K102 as the knockout drum ahead of J102" ;
    ns1:about ns1:TRIP_LSHH110 ;
    ns1:citedIn ns1:SL02__sflcit01 ;
    ns1:description "The matrix calls K102 the 'relief collection vessel' (LSHH-110, full plant shutdown); the KG holds K102 as the knockout drum ahead of J102" ;
    ns1:foundBy "sfl section build, Oct 2026" ;
    ns1:itemStatus "open" ;
    ns1:resolvedBy "Check on the P&ID and plant" .

ns1:SL03 a ns1:OpenItem ;
    rdfs:label "SL03: The matrix describes SOV-170 as 'Feed to bottom of E-101' and SOV-171 as 'Feed to K-101'; the team trace has SDV170 on the N2 recycle from K101 to K102 (with FCV111)" ;
    ns1:about ns1:TRIP_LAHH104,
        ns1:TRIP_LALL104 ;
    ns1:citedIn ns1:SL03__sflcit01 ;
    ns1:description "The matrix describes SOV-170 as 'Feed to bottom of E-101' and SOV-171 as 'Feed to K-101'; the team trace has SDV170 on the N2 recycle from K101 to K102 (with FCV111)" ;
    ns1:foundBy "sfl section build, Oct 2026" ;
    ns1:itemStatus "open" ;
    ns1:resolvedBy "Check on the P&ID and plant" .

ns1:SL04 a ns1:OpenItem ;
    rdfs:label "SL04: The relief valve schedule lists RV100 (3.8 bar, 1 inch by 2 inch) but neither RV401 nor RV301; RV401 (E100 relief to K403) may be RV100 renumbered" ;
    ns1:about ns1:RS_RV100 ;
    ns1:citedIn ns1:SL04__sflcit01 ;
    ns1:description "The relief valve schedule lists RV100 (3.8 bar, 1 inch by 2 inch) but neither RV401 nor RV301; RV401 (E100 relief to K403) may be RV100 renumbered" ;
    ns1:foundBy "sfl section build, Oct 2026" ;
    ns1:itemStatus "open" ;
    ns1:resolvedBy "Ask the plant; check the valve nameplates" .

ns1:SL05 a ns1:OpenItem ;
