ns1:TRIP_LSLL102 a ns1:SafetyTrip ;
    rdfs:label "Stripper column level LL (LZALL-102)" ;
    ns1:actionText "Stops J100, J101a, J101b. Closes XV140, FCV110. Also: alarm." ;
    ns1:citedIn ns1:TRIP_LSLL102__sflcit01 ;
    ns1:closes ns1:FCV110,
        ns1:XV140 ;
    ns1:delayText "1 min" ;
    ns1:detectedAt ns1:E100 ;
    ns1:handledBy "safety system" ;
    ns1:interlockGroup "5" ;
    ns1:stops ns1:J100,
        ns1:J101a,
        ns1:J101b ;
    ns1:switchTag "LSLL102" ;
    ns1:tag "TRIP_LSLL102" ;
    ns1:triggerCondition "Stripper column level LL: Stripper column E100 liquid level extremely low, LSLL-102 (LZALL-102); delay 1 min" ;
    ns1:tripTag "LZALL-102" .

ns1:TRIP_PALL401 a ns1:SafetyTrip ;
    rdfs:label "Stripper Column pressure LL (PALL-401)" ;
    ns1:actionText "Opens SDV424. Also: alarm." ;
    ns1:citedIn ns1:TRIP_PALL401__sflcit01 ;
    ns1:detectedAt ns1:E100 ;
    ns1:handledBy "process control system" ;
    ns1:note "See more logic in FAT reports" ;
    ns1:opens ns1:SDV424 ;
    ns1:setpointText "-0.05 barg" ;
    ns1:switchTag "PALL401" ;
    ns1:tag "TRIP_PALL401" ;
    ns1:triggerCondition "Stripper Column pressure LL: Stripper Column pressure Low Low (PALL-401); set point -0.05 barg" ;
    ns1:tripTag "PALL-401" .

