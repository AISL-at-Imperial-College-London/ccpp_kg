ns1:TRIP_LSHH103 a ns1:SafetyTrip ;
    rdfs:label "Saturation tank level HH (LZAHH-103)" ;
    ns1:actionText "Stops J102, J103, J104. Also: alarm." ;
    ns1:citedIn ns1:TRIP_LSHH103__sflcit01 ;
    ns1:detectedAt ns1:K101 ;
    ns1:handledBy "safety system" ;
    ns1:interlockGroup "6" ;
    ns1:stops ns1:J102,
        ns1:J103,
        ns1:J104 ;
    ns1:switchTag "LSHH103" ;
    ns1:tag "TRIP_LSHH103" ;
    ns1:triggerCondition "Saturation tank level HH: Saturation tank K101 liquid level extremely high, LSHH-103 (LZAHH-103)" ;
    ns1:tripTag "LZAHH-103" .

