    rdfs:label "CA02: Link strengths and time scales are not modelled (only the direction of each effect)" ;
    ns1:about ns1:V_E100_P ;
    ns1:citedIn ns1:CA02__caucit01 ;
    ns1:description "Link strengths and time scales are not modelled (only the direction of each effect)" ;
    ns1:foundBy "cau section build, Oct 2026" ;
    ns1:itemStatus "open" ;
    ns1:resolvedBy "Future work: dynamic model or plant data" .

ns1:CE_01 a ns1:CausalLink ;
    rdfs:label "X_PCV119_CLOSED raises V_E100_P" ;
    ns1:basis "control loop" ;
    ns1:causeNode ns1:X_PCV119_CLOSED ;
    ns1:citedIn ns1:CE_01__caucit01,
        ns1:CE_01__caucit02 ;
    ns1:effectNode ns1:V_E100_P ;
    ns1:mechanism "PCV119 holds the E100 pressure by recycling CO2 round K103; if it cannot open, pressure rises" ;
    ns1:polarity "raises" ;
    ns1:tag "CE_01" .

ns1:CE_02 a ns1:CausalLink ;
    rdfs:label "X_STEAM_EXCESS raises V_STEAM" ;
    ns1:basis "control loop" ;
    ns1:causeNode ns1:X_STEAM_EXCESS ;
    ns1:citedIn ns1:CE_02__caucit01 ;
    ns1:effectNode ns1:V_STEAM ;
    ns1:mechanism "a wider FCV110 opening admits more steam" ;
    ns1:polarity "raises" ;
    ns1:tag "CE_02" .

ns1:CE_03 a ns1:CausalLink ;
    rdfs:label "X_STEAM_FAIL lowers V_STEAM" ;
    ns1:basis "HAZOP" ;
    ns1:causeNode ns1:X_STEAM_FAIL ;
    ns1:citedIn ns1:CE_03__caucit01 ;
    ns1:effectNode ns1:V_STEAM ;
    ns1:mechanism "no steam reaches H100; the plant shuts down on steam failure" ;
    ns1:polarity "lowers" ;
    ns1:tag "CE_03" .

ns1:CE_04 a ns1:CausalLink ;
    rdfs:label "V_STEAM raises V_E100_T" ;
    ns1:basis "control loop" ;
    ns1:causeNode ns1:V_STEAM ;
    ns1:citedIn ns1:CE_04__caucit01,
        ns1:CE_04__caucit02 ;
    ns1:effectNode ns1:V_E100_T ;
    ns1:mechanism "more steam to H100 heats and boils more MEA" ;
    ns1:polarity "raises" ;
    ns1:tag "CE_04" .

ns1:CE_05 a ns1:CausalLink ;
    rdfs:label "V_E100_T raises V_E100_P" ;
    ns1:basis "HAZOP" ;
    ns1:causeNode ns1:V_E100_T ;
    ns1:citedIn ns1:CE_05__caucit01,
        ns1:CE_05__caucit02 ;
    ns1:effectNode ns1:V_E100_P ;
    ns1:mechanism "more boil-up gives more vapour in the column" ;
    ns1:polarity "raises" ;
    ns1:tag "CE_05" .

ns1:CE_06 a ns1:CausalLink ;
    rdfs:label "V_E100_P raises V_E100_T" ;
    ns1:basis "HAZOP" ;
    ns1:causeNode ns1:V_E100_P ;
    ns1:citedIn ns1:CE_06__caucit01 ;
    ns1:effectNode ns1:V_E100_T ;
    ns1:mechanism "a higher column pressure raises the MEA boiling temperature" ;
    ns1:polarity "raises" ;
    ns1:tag "CE_06" .

ns1:CE_07 a ns1:CausalLink ;
    rdfs:label "V_E100_T raises V_E100_CO2_RELEASE" ;
    ns1:basis "HAZOP" ;
    ns1:causeNode ns1:V_E100_T ;
    ns1:citedIn ns1:CE_07__caucit01 ;
    ns1:effectNode ns1:V_E100_CO2_RELEASE ;
    ns1:mechanism "a hotter stripper releases more CO2 from the rich MEA" ;
    ns1:polarity "raises" ;
    ns1:tag "CE_07" .

ns1:CE_08 a ns1:CausalLink ;
    rdfs:label "V_E100_CO2_RELEASE lowers V_E101_CO2_OUT" ;
    ns1:basis "physical rule" ;
    ns1:causeNode ns1:V_E100_CO2_RELEASE ;
    ns1:citedIn ns1:CE_08__caucit01 ;
    ns1:effectNode ns1:V_E101_CO2_OUT ;
    ns1:mechanism "MEA stripped of more CO2 returns leaner and captures more in E101" ;
    ns1:polarity "lowers" ;
    ns1:tag "CE_08" .

ns1:CE_09 a ns1:CausalLink ;
    rdfs:label "V_H200_DUTY raises V_RICH_T" ;
    ns1:basis "control loop" ;
    ns1:causeNode ns1:V_H200_DUTY ;
    ns1:citedIn ns1:CE_09__caucit01 ;
    ns1:effectNode ns1:V_RICH_T ;
    ns1:mechanism "the electric heaters warm the rich MEA before E100" ;
    ns1:polarity "raises" ;
    ns1:tag "CE_09" .

ns1:CE_10 a ns1:CausalLink ;
    rdfs:label "V_RICH_T raises V_E100_T" ;
    ns1:basis "physical rule" ;
    ns1:causeNode ns1:V_RICH_T ;
    ns1:citedIn ns1:CE_10__caucit01 ;
    ns1:effectNode ns1:V_E100_T ;
    ns1:mechanism "a hotter rich feed adds heat to the stripper" ;
    ns1:polarity "raises" ;
    ns1:tag "CE_10" .

ns1:CE_11 a ns1:CausalLink ;
    rdfs:label "V_C400_CW lowers V_C400_T" ;
    ns1:basis "control loop" ;
    ns1:causeNode ns1:V_C400_CW ;
    ns1:citedIn ns1:CE_11__caucit01 ;
    ns1:effectNode ns1:V_C400_T ;
    ns1:mechanism "more cooling water cools the overhead gas leaving C400" ;
    ns1:polarity "lowers" ;
    ns1:tag "CE_11" .

ns1:CE_12 a ns1:CausalLink ;
    rdfs:label "X_C400_CW_LOST lowers V_C400_CW" ;
    ns1:basis "HAZOP" ;
    ns1:causeNode ns1:X_C400_CW_LOST ;
    ns1:citedIn ns1:CE_12__caucit01,
        ns1:CE_12__caucit02 ;
    ns1:effectNode ns1:V_C400_CW ;
    ns1:mechanism "the C400 cooling water stops" ;
    ns1:polarity "lowers" ;
    ns1:tag "CE_12" .

ns1:CE_13 a ns1:CausalLink ;
    rdfs:label "V_C400_T raises V_E100_P" ;
    ns1:basis "HAZOP" ;
    ns1:causeNode ns1:V_C400_T ;
    ns1:citedIn ns1:CE_13__caucit01 ;
    ns1:effectNode ns1:V_E100_P ;
    ns1:mechanism "less condensation in C400 leaves more vapour, raising the overhead and column pressure" ;
    ns1:polarity "raises" ;
    ns1:tag "CE_13" .

ns1:CE_14 a ns1:CausalLink ;
    rdfs:label "V_C400_T raises V_J103_CARRY" ;
    ns1:basis "HAZOP" ;
    ns1:causeNode ns1:V_C400_T ;
    ns1:citedIn ns1:CE_14__caucit01 ;
    ns1:effectNode ns1:V_J103_CARRY ;
    ns1:mechanism "hot, uncondensed vapour carries over to J103" ;
    ns1:polarity "raises" ;
    ns1:tag "CE_14" .

ns1:CE_15 a ns1:CausalLink ;
    rdfs:label "V_E100_T raises V_J103_CARRY" ;
    ns1:basis "HAZOP" ;
    ns1:causeNode ns1:V_E100_T ;
    ns1:citedIn ns1:CE_15__caucit01 ;
    ns1:effectNode ns1:V_J103_CARRY ;
    ns1:mechanism "excessive boiling sends excess vapour on to J103" ;
    ns1:polarity "raises" ;
    ns1:tag "CE_15" .

ns1:CE_16 a ns1:CausalLink ;
    rdfs:label "X_K401_BLOCKED raises V_K401_DP" ;
    ns1:basis "HAZOP" ;
    ns1:causeNode ns1:X_K401_BLOCKED ;
    ns1:citedIn ns1:CE_16__caucit01 ;
    ns1:effectNode ns1:V_K401_DP ;
    ns1:mechanism "a blocked demister raises the pressure drop between PT401 and PT402" ;
    ns1:polarity "raises" ;
    ns1:tag "CE_16" .

ns1:CE_17 a ns1:CausalLink ;
    rdfs:label "X_K401_BLOCKED lowers V_CO2_RET" ;
    ns1:basis "HAZOP" ;
    ns1:causeNode ns1:X_K401_BLOCKED ;
    ns1:citedIn ns1:CE_17__caucit01,
        ns1:CE_17__caucit02 ;
    ns1:effectNode ns1:V_CO2_RET ;
    ns1:mechanism "a blocked demister stops gas reaching the compressor" ;
    ns1:polarity "lowers" ;
    ns1:tag "CE_17" .

ns1:CE_18 a ns1:CausalLink ;
    rdfs:label "X_J103_STOPS lowers V_CO2_RET" ;
    ns1:basis "HAZOP" ;
    ns1:causeNode ns1:X_J103_STOPS ;
    ns1:citedIn ns1:CE_18__caucit01 ;
    ns1:effectNode ns1:V_CO2_RET ;
    ns1:mechanism "the compressor no longer draws CO2 from K401" ;
    ns1:polarity "lowers" ;
    ns1:tag "CE_18" .

ns1:CE_19 a ns1:CausalLink ;
    rdfs:label "V_CO2_RET lowers V_E100_P" ;
    ns1:basis "physical rule" ;
    ns1:causeNode ns1:V_CO2_RET ;
    ns1:citedIn ns1:CE_19__caucit01 ;
    ns1:effectNode ns1:V_E100_P ;
    ns1:mechanism "if gas cannot leave the overhead, the stripper pressure rises" ;
    ns1:polarity "lowers" ;
    ns1:tag "CE_19" .

ns1:CE_20 a ns1:CausalLink ;
    rdfs:label "X_PCV300_CLOSED raises V_E101_P" ;
    ns1:basis "control loop" ;
    ns1:causeNode ns1:X_PCV300_CLOSED ;
    ns1:citedIn ns1:CE_20__caucit01,
        ns1:CE_20__caucit02 ;
    ns1:effectNode ns1:V_E101_P ;
    ns1:mechanism "PCV300 holds the E101 pressure by venting lean gas; if it cannot open, pressure rises" ;
    ns1:polarity "raises" ;
    ns1:tag "CE_20" .

ns1:CE_21 a ns1:CausalLink ;
    rdfs:label "X_GAS_FEED_HIGH raises V_E101_P" ;
    ns1:basis "HAZOP" ;
    ns1:causeNode ns1:X_GAS_FEED_HIGH ;
    ns1:citedIn ns1:CE_21__caucit01 ;
    ns1:effectNode ns1:V_E101_P ;
    ns1:mechanism "a high gas feed rate overpressures the lower section of E101 and K101" ;
    ns1:polarity "raises" ;
    ns1:tag "CE_21" .

ns1:CE_22 a ns1:CausalLink ;
    rdfs:label "X_J102_STOPS lowers V_E101_GAS" ;
    ns1:basis "HAZOP" ;
    ns1:causeNode ns1:X_J102_STOPS ;
    ns1:citedIn ns1:CE_22__caucit01 ;
    ns1:effectNode ns1:V_E101_GAS ;
    ns1:mechanism "with the blower stopped, no N2 flows up the column" ;
    ns1:polarity "lowers" ;
    ns1:tag "CE_22" .

ns1:CE_23 a ns1:CausalLink ;
    rdfs:label "X_FCV111_OPENS lowers V_E101_GAS" ;
    ns1:basis "control loop" ;
    ns1:causeNode ns1:X_FCV111_OPENS ;
    ns1:citedIn ns1:CE_23__caucit01 ;
    ns1:effectNode ns1:V_E101_GAS ;
    ns1:mechanism "more N2 is recycled from K101 back to K102 instead of entering E101" ;
    ns1:polarity "lowers" ;
    ns1:tag "CE_23" .

ns1:CE_24 a ns1:CausalLink ;
    rdfs:label "V_C200_CW lowers V_LEAN_T" ;
    ns1:basis "control loop" ;
    ns1:causeNode ns1:V_C200_CW ;
    ns1:citedIn ns1:CE_24__caucit01 ;
    ns1:effectNode ns1:V_LEAN_T ;
    ns1:mechanism "more cooling water cools the lean MEA leaving C200" ;
    ns1:polarity "lowers" ;
    ns1:tag "CE_24" .

ns1:CE_25 a ns1:CausalLink ;
    rdfs:label "X_C200_CW_LOST lowers V_C200_CW" ;
    ns1:basis "HAZOP" ;
    ns1:causeNode ns1:X_C200_CW_LOST ;
    ns1:citedIn ns1:CE_25__caucit01,
        ns1:CE_25__caucit02 ;
    ns1:effectNode ns1:V_C200_CW ;
    ns1:mechanism "the C200 cooling water stops" ;
    ns1:polarity "lowers" ;
    ns1:tag "CE_25" .

ns1:CE_26 a ns1:CausalLink ;
    rdfs:label "V_LEAN_T raises V_E101_CO2_OUT" ;
    ns1:basis "HAZOP" ;
    ns1:causeNode ns1:V_LEAN_T ;
    ns1:citedIn ns1:CE_26__caucit01,
        ns1:CE_26__caucit02 ;
    ns1:effectNode ns1:V_E101_CO2_OUT ;
    ns1:mechanism "hotter lean MEA absorbs CO2 less well" ;
    ns1:polarity "raises" ;
    ns1:tag "CE_26" .

ns1:CE_27 a ns1:CausalLink ;
    rdfs:label "X_C100_NO_XFLOW raises V_C200_IN_T" ;
    ns1:basis "HAZOP" ;
    ns1:causeNode ns1:X_C100_NO_XFLOW ;
    ns1:citedIn ns1:CE_27__caucit01 ;
    ns1:effectNode ns1:V_C200_IN_T ;
    ns1:mechanism "without rich MEA crossflow, C100 no longer cools the lean MEA" ;
    ns1:polarity "raises" ;
    ns1:tag "CE_27" .

ns1:CE_28 a ns1:CausalLink ;
    rdfs:label "V_C200_IN_T raises V_LEAN_T" ;
    ns1:basis "physical rule" ;
    ns1:causeNode ns1:V_C200_IN_T ;
    ns1:citedIn ns1:CE_28__caucit01 ;
    ns1:effectNode ns1:V_LEAN_T ;
    ns1:mechanism "a hotter C200 inlet gives a hotter outlet unless C200 compensates" ;
    ns1:polarity "raises" ;
    ns1:tag "CE_28" .

ns1:CE_29 a ns1:CausalLink ;
    rdfs:label "V_C200_IN_T raises V_J100_CAV" ;
    ns1:basis "HAZOP" ;
    ns1:causeNode ns1:V_C200_IN_T ;
    ns1:citedIn ns1:CE_29__caucit01 ;
    ns1:effectNode ns1:V_J100_CAV ;
    ns1:mechanism "hot lean MEA at the pump suction risks cavitation" ;
    ns1:polarity "raises" ;
    ns1:tag "CE_29" .

ns1:CE_30 a ns1:CausalLink ;
    rdfs:label "V_LEAN_FLOW lowers V_E101_CO2_OUT" ;
    ns1:basis "physical rule" ;
    ns1:causeNode ns1:V_LEAN_FLOW ;
    ns1:citedIn ns1:CE_30__caucit01 ;
    ns1:effectNode ns1:V_E101_CO2_OUT ;
    ns1:mechanism "less solvent through E101 captures less CO2" ;
    ns1:polarity "lowers" ;
    ns1:tag "CE_30" .

ns1:CE_31 a ns1:CausalLink ;
    rdfs:label "V_CO2_FEED raises V_E101_CO2_OUT" ;
    ns1:basis "HAZOP" ;
    ns1:causeNode ns1:V_CO2_FEED ;
    ns1:citedIn ns1:CE_31__caucit01 ;
    ns1:effectNode ns1:V_E101_CO2_OUT ;
    ns1:mechanism "more CO2 fed than the solvent can absorb leaves in the outlet gas" ;
    ns1:polarity "raises" ;
    ns1:tag "CE_31" .

ns1:CE_32 a ns1:CausalLink ;
    rdfs:label "X_FCV105_STUCK raises V_CO2_FEED" ;
    ns1:basis "HAZOP" ;
    ns1:causeNode ns1:X_FCV105_STUCK ;
    ns1:citedIn ns1:CE_32__caucit01 ;
    ns1:effectNode ns1:V_CO2_FEED ;
    ns1:mechanism "a jammed-open FCV105 admits too much CO2" ;
    ns1:polarity "raises" ;
    ns1:tag "CE_32" .

ns1:CE_33 a ns1:CausalLink ;
    rdfs:label "X_J100_FAST raises V_LEAN_FLOW" ;
    ns1:basis "physical rule" ;
    ns1:causeNode ns1:X_J100_FAST ;
    ns1:citedIn ns1:CE_33__caucit01 ;
    ns1:effectNode ns1:V_LEAN_FLOW ;
    ns1:mechanism "a faster J100 pumps more lean MEA" ;
    ns1:polarity "raises" ;
    ns1:tag "CE_33" .

ns1:CE_34 a ns1:CausalLink ;
    rdfs:label "V_LEAN_FLOW lowers V_E100_L" ;
    ns1:basis "report" ;
    ns1:causeNode ns1:V_LEAN_FLOW ;
    ns1:citedIn ns1:CE_34__caucit01 ;
    ns1:effectNode ns1:V_E100_L ;
    ns1:mechanism "J100 draws MEA out of the E100 base; LT101 falls as J100 power rises" ;
    ns1:polarity "lowers" ;
    ns1:tag "CE_34" .

ns1:CE_35 a ns1:CausalLink ;
    rdfs:label "V_LEAN_FLOW raises V_E101_L" ;
    ns1:basis "HAZOP" ;
    ns1:causeNode ns1:V_LEAN_FLOW ;
    ns1:citedIn ns1:CE_35__caucit01 ;
    ns1:effectNode ns1:V_E101_L ;
    ns1:mechanism "lean MEA arriving faster than it leaves fills the E101 base" ;
    ns1:polarity "raises" ;
    ns1:tag "CE_35" .

ns1:CE_36 a ns1:CausalLink ;
    rdfs:label "V_RICH_FLOW lowers V_E101_L" ;
    ns1:basis "report" ;
    ns1:causeNode ns1:V_RICH_FLOW ;
    ns1:citedIn ns1:CE_36__caucit01,
        ns1:CE_36__caucit02 ;
    ns1:effectNode ns1:V_E101_L ;
    ns1:mechanism "J101 draws rich MEA out of the E101 base" ;
    ns1:polarity "lowers" ;
    ns1:tag "CE_36" .

ns1:CE_37 a ns1:CausalLink ;
    rdfs:label "V_RICH_FLOW raises V_E100_L" ;
    ns1:basis "HAZOP" ;
    ns1:causeNode ns1:V_RICH_FLOW ;
    ns1:citedIn ns1:CE_37__caucit01 ;
    ns1:effectNode ns1:V_E100_L ;
    ns1:mechanism "rich MEA arriving faster than J100 removes it fills the E100 base" ;
    ns1:polarity "raises" ;
    ns1:tag "CE_37" .

ns1:CE_38 a ns1:CausalLink ;
    rdfs:label "X_J101_STOPS lowers V_RICH_FLOW" ;
    ns1:basis "HAZOP" ;
    ns1:causeNode ns1:X_J101_STOPS ;
    ns1:citedIn ns1:CE_38__caucit01 ;
    ns1:effectNode ns1:V_RICH_FLOW ;
    ns1:mechanism "rich MEA stops leaving E101" ;
    ns1:polarity "lowers" ;
    ns1:tag "CE_38" .

ns1:CE_39 a ns1:CausalLink ;
    rdfs:label "X_Z102_BLOCKED raises V_Z102_DP" ;
    ns1:basis "HAZOP" ;
    ns1:causeNode ns1:X_Z102_BLOCKED ;
    ns1:citedIn ns1:CE_39__caucit01,
        ns1:CE_39__caucit02 ;
    ns1:effectNode ns1:V_Z102_DP ;
    ns1:mechanism "a blocked filter raises the pressure drop across Z102 (intervene at 0.45 bar)" ;
    ns1:polarity "raises" ;
    ns1:tag "CE_39" .

ns1:CE_40 a ns1:CausalLink ;
    rdfs:label "V_Z102_DP lowers V_LEAN_FLOW" ;
    ns1:basis "HAZOP" ;
    ns1:causeNode ns1:V_Z102_DP ;
    ns1:citedIn ns1:CE_40__caucit01 ;
    ns1:effectNode ns1:V_LEAN_FLOW ;
    ns1:mechanism "a restricted filter reduces the lean MEA flow" ;
    ns1:polarity "lowers" ;
    ns1:tag "CE_40" .

ns1:CE_41 a ns1:CausalLink ;
    rdfs:label "V_E100_L lowers V_J100_CAV" ;
    ns1:basis "HAZOP" ;
    ns1:causeNode ns1:V_E100_L ;
    ns1:citedIn ns1:CE_41__caucit01,
        ns1:CE_41__caucit02 ;
    ns1:effectNode ns1:V_J100_CAV ;
    ns1:mechanism "a low E100 level starves J100" ;
    ns1:polarity "lowers" ;
    ns1:tag "CE_41" .

ns1:CE_42 a ns1:CausalLink ;
    rdfs:label "V_C106_CW lowers V_K101_T" ;
    ns1:basis "control loop" ;
    ns1:causeNode ns1:V_C106_CW ;
    ns1:citedIn ns1:CE_42__caucit01 ;
    ns1:effectNode ns1:V_K101_T ;
    ns1:mechanism "more cooling water through C106 cools the K101 water" ;
    ns1:polarity "lowers" ;
    ns1:tag "CE_42" .

ns1:CE_43 a ns1:CausalLink ;
    rdfs:label "X_J104_STOPS lowers V_FEED_SAT" ;
    ns1:basis "HAZOP" ;
    ns1:causeNode ns1:X_J104_STOPS ;
    ns1:citedIn ns1:CE_43__caucit01 ;
    ns1:effectNode ns1:V_FEED_SAT ;
    ns1:mechanism "without circulating water, the gas into the plant is not saturated" ;
    ns1:polarity "lowers" ;
    ns1:tag "CE_43" .

ns1:CE_44 a ns1:CausalLink ;
    rdfs:label "V_E101_L raises V_K402_CARRY" ;
    ns1:basis "HAZOP" ;
    ns1:causeNode ns1:V_E101_L ;
    ns1:citedIn ns1:CE_44__caucit01,
        ns1:CE_44__caucit02 ;
    ns1:effectNode ns1:V_K402_CARRY ;
    ns1:mechanism "liquid accumulating in E101 can reach K402 and the J102 inlet" ;
    ns1:polarity "raises" ;
    ns1:tag "CE_44" .

ns1:CL_C200_temperature a ns1:ControlLoop ;
    rdfs:label "Temperature of MEA entering E101 (cascade master)" ;
    ns1:cascadeMasterOf ns1:CL_C200_cooling_water ;
    ns1:citedIn ns1:CL_C200_temperature__abscit01,
        ns1:CL_C200_temperature__abscit02 ;
    ns1:controlledVariable "Temperature of lean MEA entering E101" ;
    ns1:hasController ns1:TIC210 ;
    ns1:hasFinalElement ns1:FCV200 ;
    ns1:hasSensor ns1:TT210 ;
    ns1:manipulatedVariable "Cooling water flow set point for FIC201" .

ns1:CL_C400_temperature a ns1:ControlLoop ;
    rdfs:label "Temperature of CO2 leaving C400 (cascade master)" ;
    ns1:cascadeMasterOf ns1:CL_C400_cooling_water ;
    ns1:citedIn ns1:CL_C400_temperature__ovhcit01 ;
    ns1:controlledVariable "Temperature of CO2 exiting C400" ;
    ns1:hasController ns1:TIC410 ;
    ns1:hasFinalElement ns1:FCV401 ;
    ns1:hasSensor ns1:TT410 ;
    ns1:manipulatedVariable "Cooling water flow set point for FIC402" .

ns1:CL_CO2_feed a ns1:ControlLoop ;
