    ns1:guideword "MISDIRECTED" ;
    ns1:inElement ns1:HAZOP_element_8 ;
    ns1:itemNumber 5 ;
    ns1:parameter "FLOW" ;
    ns1:safeguard "Normally locked" .

ns1:HAZOP_8_06 a ns1:HazopDeviation ;
    rdfs:label "HAZOP 8.6" ;
    ns1:actionTaken "Soft alarm added" ;
    ns1:cause "E101 inventory hot" ;
    ns1:citedIn ns1:HAZOP_8_06__abscit01,
        ns1:HAZOP_8_06__cit01 ;
    ns1:concerns ns1:E101 ;
    ns1:consequence "Plant efficiency depressed" ;
    ns1:guideword "HIGHER" ;
    ns1:inElement ns1:HAZOP_element_8 ;
    ns1:itemNumber 6 ;
    ns1:parameter "TEMP." ;
    ns1:recommendedAction "soft alarms?" ;
    ns1:safeguard "TE indicators on E101" .

ns1:HAZOP_8_07 a ns1:HazopDeviation ;
