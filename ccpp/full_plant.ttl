ns1:ARP_E100_PSH a ns1:AlarmResponse ;
    rdfs:label "E100 high pressure shutdown (PSH at 2 barg)" ;
    ns1:actionText "1. The PSH kills the steam and electrical heating (H100 and H200a/b) and triggers plant shutdown at 2 barg. 2. Pressure control is by PIC401/PIC402 on PCV119; relief is RV401 to K403 if pressure keeps rising." ;
    ns1:actsOn ns1:H100,
        ns1:H200a,
        ns1:H200b ;
    ns1:citedIn ns1:ARP_E100_PSH__prccit01,
        ns1:ARP_E100_PSH__prccit02 ;
    ns1:respondsTo ns1:limit_PSH_E100_2barg ;
    ns1:tag "ARP_E100_PSH" ;
    ns1:triggerCondition "PSH on E100: plant shutdown at 2 barg, set well below the relief valve set point" ;
    ns1:triggeredBy ns1:E100 .

ns1:ARP_E100_PSH__prccit01 a ns1:Citation ;
    rdfs:label "Citation 1 for ARP_E100_PSH (prc)" ;
    ns1:citationText "HAZOP 2010 note M4 ('PSH on E100 to kill steam/electrical heating long before E100 pressure reaches RV set point'; 'PSH triggers plant shutdown at 2 barg')" ;
    ns1:document ns1:SRC_HAZOP ;
    ns1:location "note M4 ('PSH on E100 to kill steam/electrical heating long before E100 pressure reaches RV set point'; 'PSH triggers plant shutdown at 2 barg')" .

ns1:ARP_E100_PSH__prccit02 a ns1:Citation ;
    rdfs:label "Citation 2 for ARP_E100_PSH (prc)" ;
    ns1:citationText "HAZOP 2010 element 11, item 8 (PSH added on the column)" ;
    ns1:document ns1:SRC_HAZOP ;
    ns1:location "element 11, item 8 (PSH added on the column)" .

ns1:ARP_H200_HH__prccit01 a ns1:Citation ;
    rdfs:label "Citation 1 for ARP_H200_HH (prc)" ;
    ns1:citationText "Pilot Plant Report Appendix F.8.4 (Alarms).9, page 119" ;
    ns1:document ns1:SRC_REPORT ;
    ns1:location "Appendix F.8.4 (Alarms).9, page 119" .

ns1:ARP_LT101_H a ns1:AlarmResponse ;
    rdfs:label "LT101 high alarm response (E100 level)" ;
    ns1:actionText "1. Increase the pump power of J100 by 10%. 2. Decrease the pump power of J101a or J101b (whichever is in use) by 10%. 3. Check that the MEA valves are opened and closed according to table F.5. 4. If the level still rises and the HH alarm sounds (above 95%), initiate emergency shutdown." ;
    ns1:actsOn ns1:J100,
        ns1:J101a,
        ns1:J101b ;
    ns1:citedIn ns1:ARP_LT101_H__prccit01 ;
    ns1:respondsTo ns1:limit_F84_LT101_H,
        ns1:limit_F84_LT101_HH ;
    ns1:tag "ARP_LT101_H" ;
    ns1:triggerCondition "H alarm on LT101: E100 level above 85%; HH alarm above 95%" ;
    ns1:triggeredBy ns1:LT101 .

ns1:ARP_LT101_H__prccit01 a ns1:Citation ;
    rdfs:label "Citation 1 for ARP_LT101_H (prc)" ;
    ns1:citationText "Pilot Plant Report Appendix F.8.4 (Alarms).2, page 118" ;
    ns1:document ns1:SRC_REPORT ;
    ns1:location "Appendix F.8.4 (Alarms).2, page 118" .

ns1:ARP_LT101_L a ns1:AlarmResponse ;
    rdfs:label "LT101 low alarm response (E100 level)" ;
    ns1:actionText "1. Reduce the pump power of J100 by 10%. 2. Increase the pump power of J101a or J101b (whichever is in use) by 10%, without exceeding the maximum safe pump speed. 3. Increase the pump power of J300 by 10%. 4. Check that the MEA valves are opened and closed according to table F.5. 5. If the level still falls and the LL alarm sounds (below 1%), initiate emergency shutdown." ;
    ns1:actsOn ns1:J100,
        ns1:J101a,
        ns1:J101b,
        ns1:J300 ;
    ns1:citedIn ns1:ARP_LT101_L__prccit01 ;
    ns1:respondsTo ns1:limit_F84_LT101_L,
        ns1:limit_F84_LT101_LL ;
    ns1:tag "ARP_LT101_L" ;
    ns1:triggerCondition "L alarm on LT101: E100 level below 5%; LL alarm below 1%" ;
    ns1:triggeredBy ns1:LT101 .

ns1:ARP_LT101_L__prccit01 a ns1:Citation ;
    rdfs:label "Citation 1 for ARP_LT101_L (prc)" ;
    ns1:citationText "Pilot Plant Report Appendix F.8.4 (Alarms).1, page 117" ;
    ns1:document ns1:SRC_REPORT ;
    ns1:location "Appendix F.8.4 (Alarms).1, page 117" .

