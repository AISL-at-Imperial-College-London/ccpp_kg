ns1:ARP_LT108_H a ns1:AlarmResponse ;
    rdfs:label "LT108 high alarm response (E101 level)" ;
    ns1:actionText "1. Increase the pump power of J101a or J101b (whichever is in use) by 10%, without exceeding the maximum safe pump speed. 2. Decrease the pump power of J100 by 10%. 3. Decrease the pump power of J300 by 10%. 4. Check the valve positions against table F.5. 5. If the level still rises and the HH alarm sounds, initiate emergency shutdown." ;
    ns1:actsOn ns1:J100,
        ns1:J101a,
        ns1:J101b,
        ns1:J300 ;
    ns1:citedIn ns1:ARP_LT108_H__prccit01 ;
    ns1:respondsTo ns1:limit_F84_LT108_H ;
    ns1:tag "ARP_LT108_H" ;
    ns1:triggerCondition "H alarm on LT108: E101 level above 85%; HH alarm (value not stated)" ;
    ns1:triggeredBy ns1:LT108 .

