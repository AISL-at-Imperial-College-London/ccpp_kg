ccpp:HAZOP_9a_06 a ccpp:HazopDeviation ;
    rdfs:label "HAZOP 9a.6" ;
    ccpp:actionTaken "CVs included" ;
    ccpp:cause "'Wrong' choice of pump - centrifugal - blowback from pressurised system through pump" ;
