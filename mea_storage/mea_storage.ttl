ccpp:MEAFillRoute a ccpp:Loop ;
    rdfs:label "MEA filling route (feed tank > J105 > fill/drain header)" ;
    ccpp:citedIn ccpp:MEAFillRoute__meacit01,
        ccpp:MEAFillRoute__meacit02 ;
    ccpp:hasStep ccpp:MEAFillRoute_step_00_F100,
        ccpp:MEAFillRoute_step_01_J105,
        ccpp:MEAFillRoute_step_02_TT116,
        ccpp:MEAFillRoute_step_03_PCV126,
        ccpp:MEAFillRoute_step_04_V138,
        ccpp:MEAFillRoute_step_05_FILL_DRAIN_HEADER ;
    ccpp:inMode ccpp:Filling ;
    ccpp:note "J105 pumps MEA from the feed tank into the fill/drain header, which connects to the plant at J100 (V115/V122) and at the J101 pumps (V146/V147). Draining uses the same header back to the receiver tank." .

