    ccpp:consequence "Overfill feed tank" ;
    ccpp:guideword "REVERSE" ;
    ccpp:inElement ccpp:HAZOP_element_9a ;
    ccpp:itemNumber 6 ;
    ccpp:parameter "FLOW" ;
    ccpp:recommendedAction "Either pump has built-in CVs or fit CV downstream of pump" .

ccpp:HAZOP_9a_07 a ccpp:HazopDeviation ;
    rdfs:label "HAZOP 9a.7" ;
    ccpp:actionTaken "Liquid flow switch added" ;
    ccpp:cause "Incorrect setting of valving" ;
    ccpp:citedIn ccpp:HAZOP_9a_07__meacit01 ;
    ccpp:concerns ccpp:J105,
        ccpp:V138 ;
    ccpp:consequence "Liquid fill of whole of the filling line" ;
    ccpp:guideword "MISDIRECTED" ;
    ccpp:inElement ccpp:HAZOP_element_9a ;
    ccpp:itemNumber 7 ;
    ccpp:parameter "FLOW" ;
    ccpp:recommendedAction "Put liquid flow switch RHS of Valve 'N' (manual vent - V138) to shut down J105 only on liquid flow" ;
    ccpp:safeguard "SOPs" .

ccpp:HAZOP_9a_08 a ccpp:HazopDeviation ;
    rdfs:label "HAZOP 9a.8" ;
    ccpp:actionTaken "See SOP" ;
    ccpp:cause "Diurnal temp variation operating on locked-in liquid inventory" ;
    ccpp:citedIn ccpp:HAZOP_9a_08__meacit01 ;
    ccpp:consequence "High pressure in sections" ;
    ccpp:guideword "HIGHER" ;
    ccpp:inElement ccpp:HAZOP_element_9a ;
    ccpp:itemNumber 8 ;
    ccpp:parameter "TEMP." ;
    ccpp:recommendedAction "Valve op table to ensure no locked in sections containing liquid.  Check SOPs - esp for closedown" ;
    ccpp:safeguard "SOP issue" .

ccpp:HAZOP_9a_09 a ccpp:HazopDeviation ;
    rdfs:label "HAZOP 9a.9" ;
