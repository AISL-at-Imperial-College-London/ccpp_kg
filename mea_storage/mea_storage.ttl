ccpp:HAZOP_9a_03 a ccpp:HazopDeviation ;
    rdfs:label "HAZOP 9a.3" ;
    ccpp:actionTaken "Action completed" ;
    ccpp:cause "B100 empty or not connected" ;
    ccpp:citedIn ccpp:HAZOP_9a_03__meacit01 ;
    ccpp:consequence "Pump runs dry" ;
    ccpp:guideword "NO" ;
