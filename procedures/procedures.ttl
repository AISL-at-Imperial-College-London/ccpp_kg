    ccpp:description "F.8.4 gives the LL and HH alarm percentages only for LT101 (1% and 95%); the LL/HH values for LT104, LT108 and LT401 are not stated" ;
    ccpp:foundBy "prc section build, Oct 2026" ;
    ccpp:itemStatus "open" ;
    ccpp:resolvedBy "Alarm list from the control system (requested from Colin Hale)" .

ccpp:PR02 a ccpp:OpenItem ;
    rdfs:label "PR02: REPORT Section 2.2 defines the maximum safe pump power as the power that 'produces an LT101 reading below 10%'; the method in Sections 2.3 to 2.5 means the highest power that keeps LT101 above 10%" ;
    ccpp:about ccpp:ENV_J100,
        ccpp:J100 ;
    ccpp:citedIn ccpp:PR02__prccit01 ;
    ccpp:description "REPORT Section 2.2 defines the maximum safe pump power as the power that 'produces an LT101 reading below 10%'; the method in Sections 2.3 to 2.5 means the highest power that keeps LT101 above 10%" ;
    ccpp:foundBy "prc section build, Oct 2026" ;
    ccpp:itemStatus "open" ;
    ccpp:resolvedBy "Note for the report" .

