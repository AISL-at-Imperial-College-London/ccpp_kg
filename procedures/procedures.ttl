@prefix ccpp: <http://imperial.ac.uk/ccpp#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ccpp:ARP_E100_PSH a ccpp:AlarmResponse ;
    rdfs:label "E100 high pressure shutdown (PSH at 2 barg)" ;
    ccpp:actionText "1. The PSH kills the steam and electrical heating (H100 and H200a/b) and triggers plant shutdown at 2 barg. 2. Pressure control is by PIC401/PIC402 on PCV119; relief is RV401 to K403 if pressure keeps rising." ;
    ccpp:actsOn ccpp:H100,
        ccpp:H200a,
        ccpp:H200b ;
    ccpp:citedIn ccpp:ARP_E100_PSH__prccit01,
        ccpp:ARP_E100_PSH__prccit02 ;
    ccpp:respondsTo ccpp:limit_PSH_E100_2barg ;
    ccpp:tag "ARP_E100_PSH" ;
    ccpp:triggerCondition "PSH on E100: plant shutdown at 2 barg, set well below the relief valve set point" ;
    ccpp:triggeredBy ccpp:E100 .

ccpp:ARP_H200_HH a ccpp:AlarmResponse ;
    rdfs:label "H200a/H200b heater H and HH alarm response" ;
    ccpp:actionText "1. Check the heater set point is at the desired value. 2. If not, set the heaters to manual at their controllers in the control room, or, if in automatic, correct the set point. 3. If the heaters do not respond, turn them off at the manual switch on floor 1." ;
    ccpp:actsOn ccpp:H200a,
        ccpp:H200b ;
    ccpp:citedIn ccpp:ARP_H200_HH__prccit01 ;
    ccpp:tag "ARP_H200_HH" ;
    ccpp:triggerCondition "H and HH alarms from the electric heaters H200a and H200b (TIC213a, TIC213b)" ;
    ccpp:triggeredBy ccpp:TIC213a,
        ccpp:TIC213b .

ccpp:ARP_LT101_H a ccpp:AlarmResponse ;
    rdfs:label "LT101 high alarm response (E100 level)" ;
    ccpp:actionText "1. Increase the pump power of J100 by 10%. 2. Decrease the pump power of J101a or J101b (whichever is in use) by 10%. 3. Check that the MEA valves are opened and closed according to table F.5. 4. If the level still rises and the HH alarm sounds (above 95%), initiate emergency shutdown." ;
    ccpp:actsOn ccpp:J100,
        ccpp:J101a,
        ccpp:J101b ;
    ccpp:citedIn ccpp:ARP_LT101_H__prccit01 ;
    ccpp:respondsTo ccpp:limit_F84_LT101_H,
        ccpp:limit_F84_LT101_HH ;
    ccpp:tag "ARP_LT101_H" ;
    ccpp:triggerCondition "H alarm on LT101: E100 level above 85%; HH alarm above 95%" ;
    ccpp:triggeredBy ccpp:LT101 .

ccpp:ARP_LT101_L a ccpp:AlarmResponse ;
    rdfs:label "LT101 low alarm response (E100 level)" ;
    ccpp:actionText "1. Reduce the pump power of J100 by 10%. 2. Increase the pump power of J101a or J101b (whichever is in use) by 10%, without exceeding the maximum safe pump speed. 3. Increase the pump power of J300 by 10%. 4. Check that the MEA valves are opened and closed according to table F.5. 5. If the level still falls and the LL alarm sounds (below 1%), initiate emergency shutdown." ;
    ccpp:actsOn ccpp:J100,
        ccpp:J101a,
        ccpp:J101b,
        ccpp:J300 ;
    ccpp:citedIn ccpp:ARP_LT101_L__prccit01 ;
    ccpp:respondsTo ccpp:limit_F84_LT101_L,
        ccpp:limit_F84_LT101_LL ;
    ccpp:tag "ARP_LT101_L" ;
    ccpp:triggerCondition "L alarm on LT101: E100 level below 5%; LL alarm below 1%" ;
    ccpp:triggeredBy ccpp:LT101 .

ccpp:ARP_LT104_H a ccpp:AlarmResponse ;
    rdfs:label "LT104 high alarm response (K101 level)" ;
    ccpp:actionText "1. Decrease the pump power of J102 by 10%. 2. Decrease the pump power of J103 by 5%. 3. Check the valve positions against table F.5. 4. If the level still rises and the HH alarm sounds, initiate emergency shutdown." ;
    ccpp:actsOn ccpp:J102,
        ccpp:J103 ;
    ccpp:citedIn ccpp:ARP_LT104_H__prccit01 ;
    ccpp:respondsTo ccpp:limit_F84_LT104_H ;
    ccpp:tag "ARP_LT104_H" ;
    ccpp:triggerCondition "H alarm on LT104: K101 level above 85%; HH alarm (value not stated)" ;
    ccpp:triggeredBy ccpp:LT104 .

ccpp:ARP_LT104_L a ccpp:AlarmResponse ;
    rdfs:label "LT104 low alarm response (K101 level)" ;
    ccpp:actionText "1. Increase the pump power of J102 by 10%. 2. Increase the pump power of J103 by 5%. 3. Check the valve positions against table F.5. 4. If the level still falls and the LL alarm sounds, initiate emergency shutdown." ;
    ccpp:actsOn ccpp:J102,
        ccpp:J103 ;
    ccpp:citedIn ccpp:ARP_LT104_L__prccit01 ;
    ccpp:respondsTo ccpp:limit_F84_LT104_L ;
    ccpp:tag "ARP_LT104_L" ;
    ccpp:triggerCondition "L alarm on LT104: K101 level below 5%; LL alarm (value not stated)" ;
    ccpp:triggeredBy ccpp:LT104 .

ccpp:ARP_LT108_H a ccpp:AlarmResponse ;
    rdfs:label "LT108 high alarm response (E101 level)" ;
    ccpp:actionText "1. Increase the pump power of J101a or J101b (whichever is in use) by 10%, without exceeding the maximum safe pump speed. 2. Decrease the pump power of J100 by 10%. 3. Decrease the pump power of J300 by 10%. 4. Check the valve positions against table F.5. 5. If the level still rises and the HH alarm sounds, initiate emergency shutdown." ;
    ccpp:actsOn ccpp:J100,
        ccpp:J101a,
        ccpp:J101b,
        ccpp:J300 ;
    ccpp:citedIn ccpp:ARP_LT108_H__prccit01 ;
    ccpp:respondsTo ccpp:limit_F84_LT108_H ;
    ccpp:tag "ARP_LT108_H" ;
    ccpp:triggerCondition "H alarm on LT108: E101 level above 85%; HH alarm (value not stated)" ;
    ccpp:triggeredBy ccpp:LT108 .

ccpp:ARP_LT108_L a ccpp:AlarmResponse ;
    rdfs:label "LT108 low alarm response (E101 level)" ;
    ccpp:actionText "1. Decrease the pump power of J101a or J101b (whichever is in use) by 10%. 2. Increase the pump power of J100 by 10%. 3. Increase the pump power of J300 by 10%. 4. Check the valve positions against table F.5. 5. If the level still falls and the LL alarm sounds, initiate emergency shutdown." ;
    ccpp:actsOn ccpp:J100,
        ccpp:J101a,
        ccpp:J101b,
        ccpp:J300 ;
    ccpp:citedIn ccpp:ARP_LT108_L__prccit01 ;
    ccpp:respondsTo ccpp:limit_F84_LT108_L ;
    ccpp:tag "ARP_LT108_L" ;
    ccpp:triggerCondition "L alarm on LT108: E101 level below 5%; LL alarm (value not stated)" ;
    ccpp:triggeredBy ccpp:LT108 .

ccpp:ARP_LT401_H a ccpp:AlarmResponse ;
    rdfs:label "LT401 high alarm response (condensate level, C400/K401)" ;
    ccpp:actionText "1. Increase the pump power of J300 by 10%. 2. If the level still rises and the HH alarm sounds, initiate emergency shutdown." ;
    ccpp:actsOn ccpp:J300 ;
    ccpp:citedIn ccpp:ARP_LT401_H__prccit01 ;
    ccpp:respondsTo ccpp:limit_F84_LT401_H ;
    ccpp:tag "ARP_LT401_H" ;
    ccpp:triggerCondition "H alarm on LT401: condensate level above 85%; HH alarm (value not stated)" ;
    ccpp:triggeredBy ccpp:LT401 .

ccpp:ARP_LT401_L a ccpp:AlarmResponse ;
    rdfs:label "LT401 low alarm response (condensate level, C400/K401)" ;
    ccpp:actionText "1. Decrease the pump power of J300 by 10%. 2. If the level still falls and the LL alarm sounds, initiate emergency shutdown." ;
    ccpp:actsOn ccpp:J300 ;
    ccpp:citedIn ccpp:ARP_LT401_L__prccit01 ;
    ccpp:respondsTo ccpp:limit_F84_LT401_L ;
    ccpp:tag "ARP_LT401_L" ;
    ccpp:triggerCondition "L alarm on LT401: condensate level below 5%; LL alarm (value not stated)" ;
    ccpp:triggeredBy ccpp:LT401 .

ccpp:AlarmResponseRegister a ccpp:Loop ;
    rdfs:label "Alarm responses and operating envelopes (register, no flow route)" ;
    ccpp:citedIn ccpp:AlarmResponseRegister__prccit01,
        ccpp:AlarmResponseRegister__prccit02 ;
    ccpp:inMode ccpp:FigureOfEight ;
    ccpp:note "Documented operator responses to level, heater and pressure alarms, with their thresholds." .

ccpp:COM_LT101_HIGH a ccpp:AlarmResponse ;
    rdfs:label "Commissioning: LT101 rising above 90% (J100 test)" ;
    ccpp:actionText "1. Increase J100 pump power by 10% every 2 minutes until LT101 is below 90%. 2. If the level still does not drop, send an operator into the plant to check V110 is open. 3. Once steady below 90%, continue the test at 5% above the last steady-state pump power." ;
    ccpp:actsOn ccpp:J100,
        ccpp:V110 ;
    ccpp:citedIn ccpp:COM_LT101_HIGH__prccit01 ;
    ccpp:note "Applies to the J100 commissioning test, not full operation (full operation uses the F.8.4 alarms at 85% and 95%)." ;
    ccpp:respondsTo ccpp:limit_COM_LT101_10 ;
    ccpp:tag "COM_LT101_HIGH" ;
    ccpp:triggerCondition "Commissioning SOP: LT101 above 90% during the J100 pump test" ;
    ccpp:triggeredBy ccpp:LT101 .

ccpp:COM_LT101_LOW a ccpp:AlarmResponse ;
    rdfs:label "Commissioning: LT101 dropping below 10% (J100 test)" ;
    ccpp:actionText "1. Decrease J100 to the second-to-last steady-state value. 2. If the level keeps dropping over the next 2 minutes, reduce J100 speed by a further 10% every minute until it stops. 3. Once the level is steady above 10%, return to the last steady-state speed. 4. Increase pump speed by a smaller step than last time (10% to 5% to 2% to 1%); after a 1% step, the maximum pump power has been reached." ;
    ccpp:actsOn ccpp:J100 ;
    ccpp:citedIn ccpp:COM_LT101_LOW__prccit01 ;
    ccpp:note "Applies to the J100 commissioning test, not full operation (full operation uses the F.8.4 alarms at 5% and 1%)." ;
    ccpp:respondsTo ccpp:limit_COM_LT101_10 ;
    ccpp:tag "COM_LT101_LOW" ;
    ccpp:triggerCondition "Commissioning SOP: LT101 below 10% during the J100 pump test" ;
    ccpp:triggeredBy ccpp:LT101 .

