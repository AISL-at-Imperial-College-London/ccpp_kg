ccpp:ENV_J100 a ccpp:OperatingEnvelope ;
    rdfs:label "J100 safe operating range (pump power)" ;
    ccpp:citedIn ccpp:ENV_J100__prccit01 ;
    ccpp:envelopeOf ccpp:J100 ;
    ccpp:envelopeText "J100 safe operating range: 1%-57% pump power, accounting for cavitation (audible vibration at 55%-60%); theoretical range 1%-60%. The lower limit 1% is the weakest pump setting that still lifts MEA to the top of E100." ;
