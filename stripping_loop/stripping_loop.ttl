@prefix ccpp: <http://imperial.ac.uk/ccpp#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ccpp:CL_E100_pressure a ccpp:ControlLoop ;
    rdfs:label "E100 pressure (boundary loop on overhead)" ;
    ccpp:citedIn ccpp:CL_E100_pressure__cit01,
        ccpp:CL_E100_pressure__cit02 ;
    ccpp:controlledVariable "Pressure in E100" ;
    ccpp:hasController ccpp:PIC401,
        ccpp:PIC402 ;
    ccpp:hasFinalElement ccpp:PCV119 ;
    ccpp:hasSensor ccpp:PT401,
        ccpp:PT402 ;
    ccpp:manipulatedVariable "PCV119 opening" ;
    ccpp:source "SUMMARY p.190; REPORT D.4" .

ccpp:CL_H100_temperature_master a ccpp:ControlLoop ;
    rdfs:label "Temperature of MEA leaving H100 (cascade master)" ;
    ccpp:cascadeMasterOf ccpp:CL_H100_steam_slave ;
    ccpp:citedIn ccpp:CL_H100_temperature_master__cit01,
        ccpp:CL_H100_temperature_master__cit02 ;
    ccpp:controlledVariable "Temperature of MEA leaving H100 into E100" ;
    ccpp:hasController ccpp:TIC100 ;
    ccpp:hasFinalElement ccpp:FCV110 ;
    ccpp:hasSensor ccpp:TT100 ;
    ccpp:manipulatedVariable "Steam flow set point for FIC100" ;
    ccpp:source "SUMMARY p.190; REPORT D.4.4.c" .

ccpp:CL_H200a_temperature a ccpp:ControlLoop ;
    rdfs:label "Temperature of MEA entering E100, heater leg A" ;
    ccpp:citedIn ccpp:CL_H200a_temperature__cit01,
        ccpp:CL_H200a_temperature__cit02 ;
    ccpp:controlledVariable "Temperature of MEA entering E100" ;
    ccpp:hasController ccpp:TIC213a,
        ccpp:TY213a ;
    ccpp:hasFinalElement ccpp:H200a ;
    ccpp:hasSensor ccpp:TT213 ;
    ccpp:manipulatedVariable "Thermal duty of H200a" ;
    ccpp:source "SUMMARY p.190; REPORT D.4.4.a" .

ccpp:CL_H200b_temperature a ccpp:ControlLoop ;
    rdfs:label "Temperature of MEA entering E100, heater leg B" ;
    ccpp:citedIn ccpp:CL_H200b_temperature__cit01,
        ccpp:CL_H200b_temperature__cit02 ;
    ccpp:controlledVariable "Temperature of MEA entering E100" ;
    ccpp:hasController ccpp:TIC213b,
        ccpp:TY213b ;
    ccpp:hasFinalElement ccpp:H200b ;
    ccpp:hasSensor ccpp:TT213 ;
    ccpp:manipulatedVariable "Thermal duty of H200b" ;
    ccpp:source "SUMMARY p.190; REPORT D.4.4.a" .

ccpp:CL_J100_flow a ccpp:ControlLoop ;
    rdfs:label "MEA flow from E100 (pump speed)" ;
    ccpp:citedIn ccpp:CL_J100_flow__cit01,
        ccpp:CL_J100_flow__cit02 ;
    ccpp:controlledVariable "MEA flowrate leaving E100" ;
    ccpp:hasController ccpp:FIC103,
        ccpp:FIC104,
        ccpp:SIC100 ;
    ccpp:hasFinalElement ccpp:J100 ;
    ccpp:hasSensor ccpp:FT103,
        ccpp:FT104 ;
    ccpp:manipulatedVariable "J100 speed (via SIC100)" ;
    ccpp:source "SUMMARY p.190; REPORT D.4" .

ccpp:FT305 a ccpp:FlowInstrument ;
    rdfs:label "FT305" ;
    ccpp:citedIn ccpp:FT305__cit01,
        ccpp:FT305__cit02 ;
    ccpp:floor 3 ;
    ccpp:gridReference "F9" ;
    ccpp:measuredVariable "mass flow (reflux from J300)" ;
    ccpp:sensorType "Coriolis mass flow meter" ;
    ccpp:signalType "Profibus-PA" ;
    ccpp:tag "FT305" .

ccpp:HAZOP_11_01 a ccpp:HazopDeviation ;
    rdfs:label "HAZOP 11.1" ;
    ccpp:actionTaken "FAL added" ;
    ccpp:cause "Blockage in the packing / trays / redistributors" ;
    ccpp:citedIn ccpp:HAZOP_11_01__cit01 ;
    ccpp:concerns ccpp:E100 ;
    ccpp:consequence "Flowrate down column < inlet flowrate .: accumulation of liquid." ;
    ccpp:guideword "NO" ;
    ccpp:inElement ccpp:HAZOP_element_11 ;
    ccpp:itemNumber 1 ;
    ccpp:parameter "FLOW" ;
    ccpp:recommendedAction "Put FAL on FT402 (now FT400)  (liquid 'reflux' into E100) to detect liquid blockage at top of column" ;
    ccpp:safeguard "Low fluid inventory in system" .

