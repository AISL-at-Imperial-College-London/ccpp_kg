ccpp:HAZOP_11_11 a ccpp:HazopDeviation ;
    rdfs:label "HAZOP 11.11" ;
    ccpp:actionTaken "FAL added" ;
    ccpp:cause "C300 (now C400) not operating / excess pressure in C300" ;
