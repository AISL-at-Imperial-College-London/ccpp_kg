    ccpp:guideword "MORE" ;
    ccpp:inElement ccpp:HAZOP_element_11 ;
    ccpp:itemNumber 3 ;
    ccpp:parameter "FLOW" ;
    ccpp:safeguard "Steam controls on H1(00)" .

ccpp:HAZOP_11_04 a ccpp:HazopDeviation ;
    rdfs:label "HAZOP 11.4" ;
    ccpp:cause "less steam consumed" ;
    ccpp:consequence "low efficiency" ;
    ccpp:guideword "LESS" ;
    ccpp:inElement ccpp:HAZOP_element_11 ;
    ccpp:itemNumber 4 ;
    ccpp:parameter "FLOW" .

ccpp:HAZOP_11_05 a ccpp:HazopDeviation ;
