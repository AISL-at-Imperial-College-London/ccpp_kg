ccpp:N2ReturnLoop a ccpp:Loop ;
    rdfs:label "N2 return loop (E101 > K402 > K102 > J102 > K101 > E101)" ;
    ccpp:citedIn ccpp:N2ReturnLoop__grtcit01,
        ccpp:N2ReturnLoop__grtcit02,
        ccpp:N2ReturnLoop__grtcit03 ;
    ccpp:hasStep ccpp:N2ReturnLoop_step_00_E101,
        ccpp:N2ReturnLoop_step_01_E101_N_gas_outlet,
        ccpp:N2ReturnLoop_step_02_K402,
        ccpp:N2ReturnLoop_step_03_K402_N_gas_to_return,
        ccpp:N2ReturnLoop_step_04_TT304,
        ccpp:N2ReturnLoop_step_05_FT303,
        ccpp:N2ReturnLoop_step_06_FI303,
        ccpp:N2ReturnLoop_step_07_FT304,
        ccpp:N2ReturnLoop_step_08_FI304,
        ccpp:N2ReturnLoop_step_09_K102,
        ccpp:N2ReturnLoop_step_10_V187,
        ccpp:N2ReturnLoop_step_11_J102,
        ccpp:N2ReturnLoop_step_12_TT114,
        ccpp:N2ReturnLoop_step_13_FT107,
        ccpp:N2ReturnLoop_step_14_PCV118,
        ccpp:N2ReturnLoop_step_15_K101,
        ccpp:N2ReturnLoop_step_16_E101_N_gas_inlet,
        ccpp:N2ReturnLoop_step_17_E101 ;
    ccpp:inMode ccpp:FigureOfEight ;
    ccpp:note "N2 is not absorbed, so it is recirculated: J102 blows it from the K402 overhead back through K101 into E101. Fresh N2 and CO2 (piece 5) top it up. FCV111 recycles part of it from K101 back to K102 to set the N2 flow into E101." .

