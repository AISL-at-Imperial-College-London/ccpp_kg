ccpp:CL_C400_temperature a ccpp:ControlLoop ;
    rdfs:label "Temperature of CO2 leaving C400 (cascade master)" ;
    ccpp:cascadeMasterOf ccpp:CL_C400_cooling_water ;
    ccpp:citedIn ccpp:CL_C400_temperature__ovhcit01 ;
    ccpp:controlledVariable "Temperature of CO2 exiting C400" ;
    ccpp:hasController ccpp:TIC410 ;
    ccpp:hasFinalElement ccpp:FCV401 ;
    ccpp:hasSensor ccpp:TT410 ;
    ccpp:manipulatedVariable "Cooling water flow set point for FIC402" .

ccpp:CL_K401_level a ccpp:ControlLoop ;
    rdfs:label "K401 level (J300 speed)" ;
    ccpp:citedIn ccpp:CL_K401_level__ovhcit01 ;
    ccpp:controlledVariable "Liquid level in K401 (condenser hold-up)" ;
    ccpp:hasController ccpp:LIC401,
        ccpp:SIC300 ;
    ccpp:hasFinalElement ccpp:J300 ;
    ccpp:hasSensor ccpp:LT401 ;
    ccpp:manipulatedVariable "Speed of J300" .

ccpp:FI401 a ccpp:FlowInstrument ;
    rdfs:label "FI401" ;
