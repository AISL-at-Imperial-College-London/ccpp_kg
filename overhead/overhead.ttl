    ccpp:citedIn ccpp:OOI01__ovhcit01 ;
    ccpp:description "K401's label is not legible on the team's P&ID copy, and the 2010 HAZOP mentions both K400 and K401: is there a second pot?" ;
    ccpp:foundBy "ovh section build, Oct 2026" ;
    ccpp:itemStatus "open" ;
    ccpp:resolvedBy "Full-size P&ID or site check" .

