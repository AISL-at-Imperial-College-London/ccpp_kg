ccpp:OverheadRefluxLoop a ccpp:Loop ;
    rdfs:label "Stripper overhead and reflux loop" ;
    ccpp:citedIn ccpp:OverheadRefluxLoop__ovhcit01,
        ccpp:OverheadRefluxLoop__ovhcit02,
        ccpp:OverheadRefluxLoop__ovhcit03 ;
    ccpp:hasStep ccpp:OverheadRefluxLoop_step_00_E100,
        ccpp:OverheadRefluxLoop_step_01_E100_N_overhead,
        ccpp:OverheadRefluxLoop_step_02_PT401,
        ccpp:OverheadRefluxLoop_step_03_C400,
        ccpp:OverheadRefluxLoop_step_04_LSHH400,
        ccpp:OverheadRefluxLoop_step_05_K401,
        ccpp:OverheadRefluxLoop_step_06_LT401,
        ccpp:OverheadRefluxLoop_step_07_J300,
        ccpp:OverheadRefluxLoop_step_08_TT310,
        ccpp:OverheadRefluxLoop_step_09_RV300,
        ccpp:OverheadRefluxLoop_step_10_B300,
        ccpp:OverheadRefluxLoop_step_11_PCV302,
        ccpp:OverheadRefluxLoop_step_12_V317,
        ccpp:OverheadRefluxLoop_step_13_TT309,
        ccpp:OverheadRefluxLoop_step_14_FT305,
        ccpp:OverheadRefluxLoop_step_15_V403,
        ccpp:OverheadRefluxLoop_step_16_V402,
        ccpp:OverheadRefluxLoop_step_17_E100_N_top_inlet,
        ccpp:OverheadRefluxLoop_step_18_E100 ;
    ccpp:inMode ccpp:FigureOfEight ;
    ccpp:note "Runs whenever E100 is boiling. Vapour is condensed in C400; K401 separates the condensate (returned as reflux by J300) from the CO2-rich gas (to the CO2 return, piece 7)." .

