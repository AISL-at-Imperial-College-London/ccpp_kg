    ccpp:monitors ccpp:C400 ;
    ccpp:tag "FI401" .

ccpp:HAZOP_12_01 a ccpp:HazopDeviation ;
    rdfs:label "HAZOP 12.1" ;
    ccpp:cause "Insufficient boiling in H100" ;
    ccpp:citedIn ccpp:HAZOP_12_01__ovhcit01 ;
    ccpp:guideword "NO" ;
    ccpp:inElement ccpp:HAZOP_element_12 ;
    ccpp:itemNumber 1 ;
    ccpp:parameter "FLOW" .

ccpp:HAZOP_12_02 a ccpp:HazopDeviation ;
    rdfs:label "HAZOP 12.2" ;
    ccpp:actionTaken "PDAH added" ;
    ccpp:cause "Blockage of K401 demister unit" ;
    ccpp:citedIn ccpp:HAZOP_12_02__ovhcit01 ;
    ccpp:concerns ccpp:K401,
        ccpp:PT401,
        ccpp:PT402 ;
    ccpp:consequence "No gas flow to compressor" ;
    ccpp:guideword "NO" ;
    ccpp:inElement ccpp:HAZOP_element_12 ;
    ccpp:itemNumber 2 ;
    ccpp:parameter "FLOW" ;
    ccpp:recommendedAction "PDAH differential pressure alarm between PT402 and PT401" ;
    ccpp:safeguard "spillback around compressor" .

ccpp:HAZOP_12_03 a ccpp:HazopDeviation ;
    rdfs:label "HAZOP 12.3" ;
    ccpp:actionTaken "K400 & K401 added" ;
    ccpp:cause "Excessive boiling" ;
    ccpp:citedIn ccpp:HAZOP_12_03__ovhcit01 ;
    ccpp:concerns ccpp:C400 ;
    ccpp:consequence "Excess vapour carry-over to J103" ;
    ccpp:guideword "MORE" ;
    ccpp:inElement ccpp:HAZOP_element_12 ;
    ccpp:itemNumber 3 ;
    ccpp:parameter "FLOW" ;
    ccpp:recommendedAction "Develop operating window during & post commissioning" ;
    ccpp:safeguard "Excess waterflow through C300" .

ccpp:HAZOP_12_04 a ccpp:HazopDeviation ;
    rdfs:label "HAZOP 12.4" ;
    ccpp:cause "Insufficient boiling in H100" ;
    ccpp:citedIn ccpp:HAZOP_12_04__ovhcit01 ;
    ccpp:guideword "LESS" ;
    ccpp:inElement ccpp:HAZOP_element_12 ;
    ccpp:itemNumber 4 ;
    ccpp:parameter "FLOW" .

ccpp:HAZOP_12_05 a ccpp:HazopDeviation ;
