ccpp:GasFeedRoute a ccpp:Loop ;
    rdfs:label "Feed gas route (CO2 and N2 supplies to E101)" ;
    ccpp:citedIn ccpp:GasFeedRoute__gascit01,
        ccpp:GasFeedRoute__gascit02,
        ccpp:GasFeedRoute__gascit03 ;
    ccpp:hasStep ccpp:GasFeedRoute_step_00_CO2_SUPPLY,
        ccpp:GasFeedRoute_step_00_N2_SUPPLY,
        ccpp:GasFeedRoute_step_01_V127,
        ccpp:GasFeedRoute_step_01_V128,
        ccpp:GasFeedRoute_step_02_PCV116,
        ccpp:GasFeedRoute_step_02_PCV117,
        ccpp:GasFeedRoute_step_03_FT105,
        ccpp:GasFeedRoute_step_03_PCV115,
        ccpp:GasFeedRoute_step_04_FCV105,
        ccpp:GasFeedRoute_step_04_FCV116,
        ccpp:GasFeedRoute_step_05_NRV101,
        ccpp:GasFeedRoute_step_05_NRV102,
        ccpp:GasFeedRoute_step_06_FEED_GAS_HEADER,
        ccpp:GasFeedRoute_step_07_K101,
        ccpp:GasFeedRoute_step_08_TT121,
        ccpp:GasFeedRoute_step_09_E101_N_gas_inlet,
        ccpp:GasFeedRoute_step_10_E101 ;
    ccpp:inMode ccpp:FigureOfEight ;
    ccpp:note "Fresh CO2 and N2 are metered by mass flow controllers (FIC105, FIC116), meet at a tee, pass through the K101 saturator (or its bypass, FCV111) and enter the base of E101. The route after the tee is inferred." .

ccpp:HAZOP_1_01 a ccpp:HazopDeviation ;
    rdfs:label "HAZOP 1.1" ;
    ccpp:actionTaken "Vent valve added" ;
    ccpp:cause "Seal failure in NRV103" ;
