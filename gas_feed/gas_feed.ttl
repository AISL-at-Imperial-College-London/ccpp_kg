@prefix ccpp: <http://imperial.ac.uk/ccpp#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ccpp:CL_CO2_feed a ccpp:ControlLoop ;
    rdfs:label "CO2 feed rate (CO2 concentration into the plant)" ;
    ccpp:citedIn ccpp:CL_CO2_feed__gascit01 ;
    ccpp:controlledVariable "CO2 feed rate" ;
    ccpp:hasController ccpp:FIC105 ;
    ccpp:hasFinalElement ccpp:FCV105 ;
    ccpp:hasSensor ccpp:FT105 ;
    ccpp:manipulatedVariable "FCV105 opening" .

ccpp:CL_K101_temperature a ccpp:ControlLoop ;
    rdfs:label "K101 saturator temperature (cascade master)" ;
    ccpp:cascadeMasterOf ccpp:CL_C106_cooling_water ;
    ccpp:citedIn ccpp:CL_K101_temperature__gascit01 ;
    ccpp:controlledVariable "Saturator K101 temperature" ;
    ccpp:hasController ccpp:TIC121 ;
    ccpp:hasFinalElement ccpp:FCV102 ;
    ccpp:hasSensor ccpp:TT121 ;
    ccpp:manipulatedVariable "Cooling water flow set point for FIC106" .

ccpp:CL_N2_feed a ccpp:ControlLoop ;
    rdfs:label "N2 feed rate" ;
    ccpp:citedIn ccpp:CL_N2_feed__gascit01 ;
    ccpp:controlledVariable "Nitrogen feed rate" ;
    ccpp:hasController ccpp:FIC116 ;
    ccpp:hasFinalElement ccpp:FCV116 ;
    ccpp:hasSensor ccpp:FT116 ;
    ccpp:manipulatedVariable "FCV116 opening" .

ccpp:CL_N2_to_E101 a ccpp:ControlLoop ;
    rdfs:label "N2 flowrate entering E101 (on K101 bypass rate)" ;
    ccpp:citedIn ccpp:CL_N2_to_E101__gascit01 ;
    ccpp:controlledVariable "Nitrogen flowrate entering E101" ;
    ccpp:hasController ccpp:FIC303,
        ccpp:FIC304 ;
    ccpp:hasFinalElement ccpp:FCV111 ;
    ccpp:hasSensor ccpp:FT303,
        ccpp:FT304 ;
    ccpp:manipulatedVariable "K101 bypass rate (FCV111)" .

ccpp:GOI01 a ccpp:OpenItem ;
    rdfs:label "GOI01: Order of items on each supply line (regulator, flow meter, mass flow controller, non-return valve)" ;
    ccpp:about ccpp:FCV105,
        ccpp:FCV116 ;
    ccpp:citedIn ccpp:GOI01__gascit01 ;
    ccpp:description "Order of items on each supply line (regulator, flow meter, mass flow controller, non-return valve)" ;
    ccpp:foundBy "gas section build, Oct 2026" ;
    ccpp:itemStatus "open" ;
    ccpp:resolvedBy "Trace on the P&ID" .

ccpp:GOI02 a ccpp:OpenItem ;
    rdfs:label "GOI02: Where the common N2 + CO2 inlet goes after the tee (through K101 to the E101 base is inferred), and where the analysis bypass line is" ;
    ccpp:about ccpp:FEED_GAS_HEADER,
        ccpp:K101 ;
    ccpp:citedIn ccpp:GOI02__gascit01 ;
    ccpp:description "Where the common N2 + CO2 inlet goes after the tee (through K101 to the E101 base is inferred), and where the analysis bypass line is" ;
    ccpp:foundBy "gas section build, Oct 2026" ;
    ccpp:itemStatus "open" ;
    ccpp:resolvedBy "Trace on the P&ID" .

ccpp:GOI03 a ccpp:OpenItem ;
    rdfs:label "GOI03: Positions and roles of FCV111 (K101 bypass), SDV170 and NRV111 near the E101 gas inlet" ;
    ccpp:about ccpp:FCV111,
        ccpp:NRV111,
        ccpp:SDV170 ;
    ccpp:citedIn ccpp:GOI03__gascit01 ;
    ccpp:description "Positions and roles of FCV111 (K101 bypass), SDV170 and NRV111 near the E101 gas inlet" ;
    ccpp:foundBy "gas section build, Oct 2026" ;
    ccpp:itemStatus "open" ;
    ccpp:resolvedBy "Trace on the P&ID" .

ccpp:GOI04 a ccpp:OpenItem ;
    rdfs:label "GOI04: Tag renumbering since 2010: HAZOP FCV106 = FCV105 (CO2) and FCV107 = FCV106 (N2), but the SUMMARY uses FCV116/FIC116 for N2 and FIC106 for C106 cooling water" ;
    ccpp:about ccpp:FCV105,
        ccpp:FCV116 ;
    ccpp:citedIn ccpp:GOI04__gascit01 ;
    ccpp:description "Tag renumbering since 2010: HAZOP FCV106 = FCV105 (CO2) and FCV107 = FCV106 (N2), but the SUMMARY uses FCV116/FIC116 for N2 and FIC106 for C106 cooling water" ;
    ccpp:foundBy "gas section build, Oct 2026" ;
    ccpp:itemStatus "open" ;
    ccpp:resolvedBy "Instrument index or site check" .

ccpp:GOI05 a ccpp:OpenItem ;
    rdfs:label "GOI05: RV103 and RV104: which line each protects and their set pressures (HAZOP pairing contradicts the REPORT grids)" ;
    ccpp:about ccpp:RV103,
        ccpp:RV104 ;
    ccpp:citedIn ccpp:GOI05__gascit01 ;
    ccpp:description "RV103 and RV104: which line each protects and their set pressures (HAZOP pairing contradicts the REPORT grids)" ;
    ccpp:foundBy "gas section build, Oct 2026" ;
    ccpp:itemStatus "open" ;
    ccpp:resolvedBy "Read the 'SET TO' values on the P&ID" .

ccpp:GOI06 a ccpp:OpenItem ;
