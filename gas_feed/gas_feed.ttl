    ccpp:resolvedBy "Site check" .

ccpp:GOI07 a ccpp:OpenItem ;
    rdfs:label "GOI07: K101 water loop order (J104 > C106 > K101 assumed), where FT110 sits, and the K101 level instrument tags" ;
    ccpp:about ccpp:C106,
        ccpp:J104,
        ccpp:K101 ;
    ccpp:citedIn ccpp:GOI07__gascit01 ;
