    ccpp:itemStatus "open" ;
    ccpp:resolvedBy "Trace on the P&ID" .

ccpp:GOI08 a ccpp:OpenItem ;
    rdfs:label "GOI08: FT303/FT304 are on floor 3 (H17) yet measure the N2 entering E101; they may be on the N2 return line (piece 7)" ;
    ccpp:about ccpp:FT303,
        ccpp:FT304 ;
    ccpp:citedIn ccpp:GOI08__gascit01 ;
