    ccpp:feedsInto ccpp:NRV101 ;
    ccpp:floor 1 ;
    ccpp:gridReference "K21" ;
    ccpp:normalPosition "open" ;
    ccpp:note "CO2 mass flow controller (FIC105); the 2010 HAZOP calls it FCV106." ;
    ccpp:pipedTo ccpp:NRV101 ;
    ccpp:tag "FCV105" ;
    ccpp:valveType "flow control (mass flow controller)" .

ccpp:K101 a ccpp:Saturator ;
    rdfs:label "K101 gas saturator" ;
    ccpp:citedIn ccpp:K101__gascit01,
        ccpp:K101__gascit02,
        ccpp:K101__gascit03 ;
    ccpp:feedsInto ccpp:E101_N_gas_inlet ;
    ccpp:floor 1 ;
    ccpp:note "Saturates the feed gas with water before E101; temperature held by TIC121 using C106 on the recirculating water. Grid not in the REPORT lists (near L17 to L18 on the P&ID). Not modelled in Aspen (GOI09)." ;
    ccpp:pipedTo ccpp:E101_N_gas_inlet,
        ccpp:J104 ;
    ccpp:tag "K101" .

