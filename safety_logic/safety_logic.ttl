ccpp:SafetyLogicRegister a ccpp:Loop ;
    rdfs:label "Safety logic: trips and relief valve schedule (register, no flow route)" ;
    ccpp:citedIn ccpp:SafetyLogicRegister__sflcit01,
        ccpp:SafetyLogicRegister__sflcit02 ;
    ccpp:inMode ccpp:FigureOfEight ;
    ccpp:note "What each trip detects, its set point and delay, and what it stops, closes or opens." .

ccpp:TRIP_LSHH103 a ccpp:SafetyTrip ;
    rdfs:label "Saturation tank level HH (LZAHH-103)" ;
    ccpp:actionText "Stops J102, J103, J104. Also: alarm." ;
    ccpp:citedIn ccpp:TRIP_LSHH103__sflcit01 ;
    ccpp:detectedAt ccpp:K101 ;
    ccpp:handledBy "safety system" ;
    ccpp:interlockGroup "6" ;
    ccpp:stops ccpp:J102,
        ccpp:J103,
        ccpp:J104 ;
    ccpp:switchTag "LSHH103" ;
    ccpp:tag "TRIP_LSHH103" ;
    ccpp:triggerCondition "Saturation tank level HH: Saturation tank K101 liquid level extremely high, LSHH-103 (LZAHH-103)" ;
    ccpp:tripTag "LZAHH-103" .

