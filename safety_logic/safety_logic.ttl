ccpp:SL01 a ccpp:OpenItem ;
    rdfs:label "SL01: XV128 (CO2 supply) and XV129 (N2 supply) shutdown valves are in the cause and effect matrix but not in the REPORT lists: find them on the P&ID near the supplies (K21 to K22 and N21 to N22)" ;
    ccpp:about ccpp:XV128,
        ccpp:XV129 ;
    ccpp:citedIn ccpp:SL01__sflcit01 ;
    ccpp:description "XV128 (CO2 supply) and XV129 (N2 supply) shutdown valves are in the cause and effect matrix but not in the REPORT lists: find them on the P&ID near the supplies (K21 to K22 and N21 to N22)" ;
    ccpp:foundBy "sfl section build, Oct 2026" ;
    ccpp:itemStatus "open" ;
    ccpp:resolvedBy "Trace on the P&ID" .

ccpp:SL02 a ccpp:OpenItem ;
    rdfs:label "SL02: The matrix calls K102 the 'relief collection vessel' (LSHH-110, full plant shutdown); the KG holds K102 as the knockout drum ahead of J102" ;
