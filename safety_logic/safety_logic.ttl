ccpp:TRIP_LZALL405 a ccpp:SafetyTrip ;
    rdfs:label "Purge line level HH (LZALL-405)" ;
    ccpp:actionText "FULL PLANT SHUTDOWN. Stops J100, J101a, J101b, J102, J103, J104, J105, J300, H200a, H200b. Closes XV128, XV129, SDV171, SDV123, SDV125, SDV152, XV140, FCV110. Also: all control loops to manual, output 0%." ;
    ccpp:citedIn ccpp:TRIP_LZALL405__sflcit01 ;
    ccpp:closes ccpp:FCV110,
        ccpp:SDV123,
        ccpp:SDV125,
        ccpp:SDV152,
        ccpp:SDV171,
        ccpp:XV128,
        ccpp:XV129,
        ccpp:XV140 ;
    ccpp:handledBy "safety system" ;
    ccpp:interlockGroup "3" ;
    ccpp:stops ccpp:H200a,
        ccpp:H200b,
        ccpp:J100,
        ccpp:J101a,
        ccpp:J101b,
        ccpp:J102,
        ccpp:J103,
        ccpp:J104,
        ccpp:J105,
        ccpp:J300 ;
    ccpp:switchTag "LSH405" ;
    ccpp:tag "TRIP_LZALL405" ;
    ccpp:triggerCondition "Purge line level HH: Purge line liquid level high (LZALL-405)" ;
    ccpp:tripTag "LZALL-405" .

