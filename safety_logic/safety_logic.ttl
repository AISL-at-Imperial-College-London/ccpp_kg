ccpp:TRIP_AZALL101 a ccpp:SafetyTrip ;
    rdfs:label "O2 level LL (AZALL-101, AZALL-102)" ;
    ccpp:actionText "FULL PLANT SHUTDOWN. Stops J100, J101a, J101b, J102, J103, J104, J105, J300, H200a, H200b. Closes XV128, XV129, SDV171, SDV123, SDV125, SDV152, XV140, FCV110. Also: all control loops to manual, output 0%; beacon; klaxon." ;
    ccpp:citedIn ccpp:TRIP_AZALL101__sflcit01 ;
    ccpp:closes ccpp:FCV110,
        ccpp:SDV123,
        ccpp:SDV125,
        ccpp:SDV152,
        ccpp:SDV171,
        ccpp:XV128,
        ccpp:XV129,
        ccpp:XV140 ;
    ccpp:handledBy "safety system" ;
    ccpp:interlockGroup "1" ;
    ccpp:setpointText "19.5%" ;
    ccpp:stops ccpp:H200a,
        ccpp:H200b,
        ccpp:J100,
        ccpp:J101a,
        ccpp:J101b,
        ccpp:J102,
        ccpp:J103,
        ccpp:J104,
        ccpp:J105,
        ccpp:J300 ;
    ccpp:switchTag "AZALL101" ;
    ccpp:tag "TRIP_AZALL101" ;
    ccpp:triggerCondition "O2 level LL: Extreme low level in plant, AT-101, AT-102 (AZALL-101, AZALL-102); set point 19.5%" ;
    ccpp:tripTag "AZALL-101, AZALL-102" .

