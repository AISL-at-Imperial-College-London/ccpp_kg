    ccpp:citationText "C&E matrix Rev 5 cause row 'O2 level LL', tag AZALL-101, AZALL-102" ;
    ccpp:document ccpp:SRC_CE ;
    ccpp:location "cause row 'O2 level LL', tag AZALL-101, AZALL-102" .

