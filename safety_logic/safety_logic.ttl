    ccpp:citedIn ccpp:SL02__sflcit01 ;
    ccpp:description "The matrix calls K102 the 'relief collection vessel' (LSHH-110, full plant shutdown); the KG holds K102 as the knockout drum ahead of J102" ;
    ccpp:foundBy "sfl section build, Oct 2026" ;
    ccpp:itemStatus "open" ;
    ccpp:resolvedBy "Check on the P&ID and plant" .

ccpp:SL03 a ccpp:OpenItem ;
    rdfs:label "SL03: The matrix describes SOV-170 as 'Feed to bottom of E-101' and SOV-171 as 'Feed to K-101'; the team trace has SDV170 on the N2 recycle from K101 to K102 (with FCV111)" ;
    ccpp:about ccpp:TRIP_LAHH104,
        ccpp:TRIP_LALL104 ;
    ccpp:citedIn ccpp:SL03__sflcit01 ;
    ccpp:description "The matrix describes SOV-170 as 'Feed to bottom of E-101' and SOV-171 as 'Feed to K-101'; the team trace has SDV170 on the N2 recycle from K101 to K102 (with FCV111)" ;
    ccpp:foundBy "sfl section build, Oct 2026" ;
    ccpp:itemStatus "open" ;
    ccpp:resolvedBy "Check on the P&ID and plant" .

