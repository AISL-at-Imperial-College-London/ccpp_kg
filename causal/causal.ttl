@prefix ccpp: <http://imperial.ac.uk/ccpp#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ccpp:CA01 a ccpp:OpenItem ;
    rdfs:label "CA01: Causal links marked 'physical rule' are engineering reasoning, not stated in a document: review CE_08, CE_10, CE_19, CE_28, CE_30 and CE_33" ;
    ccpp:about ccpp:V_E100_P,
        ccpp:V_E101_CO2_OUT ;
    ccpp:citedIn ccpp:CA01__caucit01 ;
    ccpp:description "Causal links marked 'physical rule' are engineering reasoning, not stated in a document: review CE_08, CE_10, CE_19, CE_28, CE_30 and CE_33" ;
    ccpp:foundBy "cau section build, Oct 2026" ;
    ccpp:itemStatus "open" ;
    ccpp:resolvedBy "Engineering review (supervisor or plant engineer)" .

ccpp:CA02 a ccpp:OpenItem ;
    rdfs:label "CA02: Link strengths and time scales are not modelled (only the direction of each effect)" ;
    ccpp:about ccpp:V_E100_P ;
    ccpp:citedIn ccpp:CA02__caucit01 ;
    ccpp:description "Link strengths and time scales are not modelled (only the direction of each effect)" ;
    ccpp:foundBy "cau section build, Oct 2026" ;
    ccpp:itemStatus "open" ;
    ccpp:resolvedBy "Future work: dynamic model or plant data" .

ccpp:CE_01 a ccpp:CausalLink ;
    rdfs:label "X_PCV119_CLOSED raises V_E100_P" ;
    ccpp:basis "control loop" ;
    ccpp:causeNode ccpp:X_PCV119_CLOSED ;
    ccpp:citedIn ccpp:CE_01__caucit01,
        ccpp:CE_01__caucit02 ;
    ccpp:effectNode ccpp:V_E100_P ;
    ccpp:mechanism "PCV119 holds the E100 pressure by recycling CO2 round K103; if it cannot open, pressure rises" ;
    ccpp:polarity "raises" ;
    ccpp:tag "CE_01" .

ccpp:CE_02 a ccpp:CausalLink ;
    rdfs:label "X_STEAM_EXCESS raises V_STEAM" ;
    ccpp:basis "control loop" ;
    ccpp:causeNode ccpp:X_STEAM_EXCESS ;
    ccpp:citedIn ccpp:CE_02__caucit01 ;
    ccpp:effectNode ccpp:V_STEAM ;
    ccpp:mechanism "a wider FCV110 opening admits more steam" ;
    ccpp:polarity "raises" ;
    ccpp:tag "CE_02" .

ccpp:CE_03 a ccpp:CausalLink ;
    rdfs:label "X_STEAM_FAIL lowers V_STEAM" ;
    ccpp:basis "HAZOP" ;
    ccpp:causeNode ccpp:X_STEAM_FAIL ;
    ccpp:citedIn ccpp:CE_03__caucit01 ;
    ccpp:effectNode ccpp:V_STEAM ;
    ccpp:mechanism "no steam reaches H100; the plant shuts down on steam failure" ;
    ccpp:polarity "lowers" ;
    ccpp:tag "CE_03" .

ccpp:CE_04 a ccpp:CausalLink ;
    rdfs:label "V_STEAM raises V_E100_T" ;
