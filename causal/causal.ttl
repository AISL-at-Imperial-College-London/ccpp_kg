ccpp:CausalLayer a ccpp:Loop ;
    rdfs:label "Causal layer (process variables, events and cause-and-effect links; no flow route)" ;
    ccpp:citedIn ccpp:CausalLayer__caucit01,
        ccpp:CausalLayer__caucit02 ;
    ccpp:inMode ccpp:FigureOfEight ;
    ccpp:note "Cause-and-effect knowledge for 'what could cause...' questions: walk (raises|lowers)+ back from a process variable." .

