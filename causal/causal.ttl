    ccpp:effectNode ccpp:V_E100_CO2_RELEASE ;
    ccpp:mechanism "a hotter stripper releases more CO2 from the rich MEA" ;
    ccpp:polarity "raises" ;
    ccpp:tag "CE_07" .

ccpp:CE_08 a ccpp:CausalLink ;
    rdfs:label "V_E100_CO2_RELEASE lowers V_E101_CO2_OUT" ;
