    ccpp:polarity "raises" ;
    ccpp:tag "CE_04" .

ccpp:CE_05 a ccpp:CausalLink ;
    rdfs:label "V_E100_T raises V_E100_P" ;
    ccpp:basis "HAZOP" ;
