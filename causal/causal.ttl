    ccpp:mechanism "a higher column pressure raises the MEA boiling temperature" ;
    ccpp:polarity "raises" ;
    ccpp:tag "CE_06" .

ccpp:CE_07 a ccpp:CausalLink ;
    rdfs:label "V_E100_T raises V_E100_CO2_RELEASE" ;
