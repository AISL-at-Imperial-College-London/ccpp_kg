    ccpp:effectNode ccpp:V_E100_P ;
    ccpp:mechanism "more boil-up gives more vapour in the column" ;
    ccpp:polarity "raises" ;
    ccpp:tag "CE_05" .

ccpp:CE_06 a ccpp:CausalLink ;
