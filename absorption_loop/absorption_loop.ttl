ccpp:FM_spool_route a ccpp:BypassRoute ;
    rdfs:label "Flow meter test spool route via V198b and V198a" ;
    ccpp:bypasses ccpp:V119a,
        ccpp:V119b ;
    ccpp:citedIn ccpp:FM_spool_route__abscit01,
        ccpp:FM_spool_route__abscit02 ;
    ccpp:fromItem ccpp:V124 ;
    ccpp:normalState "closed" ;
    ccpp:routeVia ccpp:FM_TEST_SPOOL,
        ccpp:V198a,
        ccpp:V198b ;
    ccpp:toItem ccpp:V211 .

ccpp:HAZOP_10_01 a ccpp:HazopDeviation ;
    rdfs:label "HAZOP 10.1" ;
    ccpp:actionTaken "Action completed" ;
    ccpp:cause "Blockage in the packing / trays / redistributors" ;
    ccpp:citedIn ccpp:HAZOP_10_01__abscit01 ;
    ccpp:consequence "Flowrate down column < inlet flowrate .: accumulation of liquid.  Worst scenario - liquid into inlet of blower J102 depending on height of blocked plane (i.e. liquid space above vs plant liquid inventory)" ;
    ccpp:guideword "NO" ;
    ccpp:inElement ccpp:HAZOP_element_10 ;
    ccpp:itemNumber 1 ;
    ccpp:parameter "FLOW" ;
    ccpp:recommendedAction "Tuning fork liquid level detection & trip downstream of K402 cyclone." ;
    ccpp:safeguard "Low fluid inventory in system" .

