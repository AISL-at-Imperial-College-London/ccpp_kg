    ccpp:note "Lean MEA enters at the top through NRV400; rich MEA leaves from the sump to J101a/b. The air admittance valve shown on the P&ID has been removed from the plant (DIFF, E14/15)." ;
    ccpp:pipedTo ccpp:E101_N_sump_outlet ;
    ccpp:tag "E101" .

ccpp:SRC_REPORT a ccpp:SourceDocument ;
    rdfs:label "Pilot Plant Report, Group 6, v2.0" ;
    ccpp:fileName "PilotPlantReport_Group6_2_0.pdf" ;
    ccpp:shortName "Pilot Plant Report" .

