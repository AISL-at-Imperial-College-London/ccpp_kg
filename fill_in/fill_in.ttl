ccpp:FI01 a ccpp:OpenItem ;
    rdfs:label "FI01: E100 ball/needle pairs V200/V201, V202/V203 (floor 2), V300/V301 (floor 3), V400/V401 (floor 4), and V107/V108 at the base: sample or drain points?" ;
    ccpp:about ccpp:V107,
        ccpp:V200,
        ccpp:V300,
        ccpp:V400 ;
    ccpp:citedIn ccpp:FI01__filcit01 ;
    ccpp:description "E100 ball/needle pairs V200/V201, V202/V203 (floor 2), V300/V301 (floor 3), V400/V401 (floor 4), and V107/V108 at the base: sample or drain points?" ;
    ccpp:foundBy "fil section build, Oct 2026" ;
    ccpp:itemStatus "open" ;
    ccpp:resolvedBy "Trace on the P&ID" .

ccpp:FI02 a ccpp:OpenItem ;
    rdfs:label "FI02: J101 pump-area valves V133, V139a/b, V141a/b, V142a/b and NRV105a/b: positions on the suction, discharge or drain lines" ;
    ccpp:about ccpp:NRV105a,
        ccpp:V133,
        ccpp:V141a ;
    ccpp:citedIn ccpp:FI02__filcit01 ;
    ccpp:description "J101 pump-area valves V133, V139a/b, V141a/b, V142a/b and NRV105a/b: positions on the suction, discharge or drain lines" ;
    ccpp:foundBy "fil section build, Oct 2026" ;
    ccpp:itemStatus "open" ;
    ccpp:resolvedBy "Trace on the P&ID" .

ccpp:FI03 a ccpp:OpenItem ;
