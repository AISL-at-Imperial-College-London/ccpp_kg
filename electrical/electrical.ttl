    ccpp:itemStatus "open" ;
    ccpp:resolvedBy "Motor control panel schedule or drive list" .

ccpp:EL03 a ccpp:OpenItem ;
    rdfs:label "EL03: Only eight instruments are shown with a 110 V supply; the power source of the other instruments, the shutdown valve solenoids and the control valves is not shown" ;
