    ccpp:citedIn ccpp:EL01__elecit01 ;
    ccpp:description "The cable diagrams are a PRELIMINARY first issue (August 2011): the final or as-built issue would confirm ratings, panels and cable routes" ;
    ccpp:foundBy "ele section build, Oct 2026" ;
    ccpp:itemStatus "open" ;
    ccpp:resolvedBy "Final issue of C2286-CD-001 from the plant" .

ccpp:EL02 a ccpp:OpenItem ;
    rdfs:label "EL02: Variable speed drives are not drawn, although J100, J101a/b and J300 are speed-controlled (SIC100, SIC101a/b, SIC300)" ;
